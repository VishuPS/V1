{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "v1",
  "main": "./worker.js",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/stores/*", "/brands/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
