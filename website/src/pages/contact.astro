---
import BaseLayout from "../layouts/BaseLayout.astro";
const subject = "BarcodeNest enquiry";
---
<BaseLayout title="Contact | BarcodeNest" description="Contact BarcodeNest about API access, technical support, product data, or commercial enquiries.">
  <header class="page-hero"><div class="narrow"><div class="eyebrow">Contact</div><h1>How can we help?</h1><p class="lede">Create an account directly or email our team for API, technical, data, and commercial questions.</p></div></header>
  <section class="section"><div class="narrow"><div class="hero-actions"><a class="button button-signal" href="/register">Get Free API Key</a><a class="button button-secondary" href={`mailto:support@barcodenest.com?subject=${encodeURIComponent(subject)}`}>Email Support</a></div><div class="contact-list"><div class="contact-row"><strong>API access</strong><span>Register and receive your first API key immediately.</span></div><div class="contact-row"><strong>Technical support</strong><span>Help with authentication, endpoints, responses, and usage.</span></div><div class="contact-row"><strong>Data questions</strong><span>Coverage, field completeness, attribution, and sources.</span></div><div class="contact-row"><strong>Commercial enquiries</strong><span>Higher-volume use cases and subscription questions.</span></div></div></div></section>
  <section class="cta-band"><div class="container cta-grid"><div><div class="eyebrow">Start building</div><h2>Your Free developer key is one registration away.</h2></div><div class="hero-actions"><a class="button button-signal" href="/register">Get Free API Key</a><a class="button" href="/docs">Documentation</a></div></div></section>
</BaseLayout>
