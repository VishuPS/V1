---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Pricing | BarcodeNest" description="Create a free BarcodeNest account with 500 product lookups per month and immediate API-key access." current="pricing">
  <header class="page-hero"><div class="container"><div class="eyebrow">Developer pricing</div><h1>Start free. Use the same API as you grow.</h1><p class="lede">Create an account now, receive an API key immediately, and manage usage from your dashboard.</p></div></header>
  <section class="section"><div class="container"><div class="pricing-grid">
    <article class="plan featured"><span class="plan-tag">Start here</span><h3>Free</h3><div class="price">&euro;0</div><ul><li>500 lookups / month</li><li>30 requests / minute</li><li>Single and batch lookup</li><li>Dashboard and key management</li></ul><a class="button button-signal" href="/register">Get API Key</a></article>
    <article class="plan"><span class="plan-tag">Starter</span><h3>10K monthly lookups</h3><div class="plan-rate">300 requests / minute</div><ul><li>Single and batch lookup</li><li>Monthly usage tracking</li><li>API key management</li><li>Email support</li></ul><a class="button" href="/register">Get API Key</a></article>
    <article class="plan"><span class="plan-tag">Pro</span><h3>100K monthly lookups</h3><div class="plan-rate">1,200 requests / minute</div><ul><li>Single and batch lookup</li><li>Monthly usage tracking</li><li>API key management</li><li>Email support</li></ul><a class="button" href="/register">Get API Key</a></article>
  </div><div class="callout"><strong>Batch quota:</strong> usage is based on individual barcode lookups. A batch containing 25 barcodes consumes 25 monthly lookups and one request against the per-minute request limit.</div></div></section>
  <section class="cta-band"><div class="container cta-grid"><div><div class="eyebrow">Free developer tier</div><h2>Create your account and make the first request.</h2></div><div class="hero-actions"><a class="button button-signal" href="/register">Get Free API Key</a><a class="button" href="/docs">Documentation</a></div></div></section>
</BaseLayout>
