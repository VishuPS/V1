---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolGrid from "../components/ToolGrid.astro";
---
<BaseLayout title="All Barcode & Product Workspace Tools | BarcodeNest" description="Explore BarcodeNest tools for barcode lookup, scanning, generation, validation, conversion, private product management, labels and data exports." current="tools"><header class="tool-hero container"><div class="eyebrow">Your barcode toolkit</div><h1>The right tool. One workspace.</h1><p class="lede">Discover, create, organise and process your barcode data. Start with Free allowances; unlock larger workflows with a paid plan.</p></header><div class="container"><ToolGrid /></div></BaseLayout>
<style>.tool-hero{padding:64px 0 16px}</style>
