import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
const limit = `{
  "error": "usage_limit_reached",
  "message": "Your monthly API call limit has been reached.",
  "plan": "free",
