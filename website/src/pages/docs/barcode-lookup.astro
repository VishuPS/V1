const response = `{
  "barcode": "3017620422003",
  "barcode_type": "EAN-13",
  "canonical_gtin": "03017620422003",
  "valid": true,
  "found": true,
  "product": {
    "name": "Nutella",
    "brand": "Ferrero",
    "quantity": "400 g",
