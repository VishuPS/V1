---
import BaseLayout from '../../layouts/BaseLayout.astro';import{platformLandings}from'../../content/platform-landings.mjs';
export function getStaticPaths(){return platformLandings.map(tool=>({params:{tool:tool.slug},props:{tool}}));}
const{tool}=Astro.props;
const schema={"@context":"https://schema.org","@graph":[{"@type":"SoftwareApplication",name:'BarcodeNest '+tool.name,applicationCategory:'BusinessApplication',operatingSystem:'Web browser',url:`https://barcodenest.com/tools/${tool.slug}/`,description:tool.description},{"@type":"FAQPage",mainEntity:tool.faqs.map(([question,answer])=>({"@type":"Question",name:question,acceptedAnswer:{"@type":"Answer",text:answer}}))}]};
---
<BaseLayout title={`${tool.title} | BarcodeNest`} description={tool.description} structuredData={schema} current="tools"><section class="hero"><div class="container"><div class="eyebrow">BarcodeNest · {tool.name}</div><h1>{tool.title}</h1><p class="hero-copy">{tool.description}</p><p>{tool.tier}</p><div class="hero-actions"><a class="button button-signal" href={tool.href}>Open {tool.name}</a><a class="button button-secondary" href="/register/">Get Started Free</a><a href="/pricing/">Compare plans</a></div></div></section><section class="section"><div class="narrow"><h2>A practical workflow for your business</h2><p class="lede">{tool.use}</p><ol>{tool.steps.map(step=><li>{step}</li>)}</ol><p>BarcodeNest keeps public product lookup separate from private customer records. An account is required to use the workspace. Your plan controls available actions and limits.</p></div></section><section class="section"><div class="narrow"><h2>Frequently asked questions</h2>{tool.faqs.map(([question,answer])=><details class="tool-faq"><summary>{question}</summary><p>{answer}</p></details>)}</div></section><section class="section"><div class="container"><h2>Continue in your barcode workspace</h2><div class="platform-tool-grid">{platformLandings.filter(related=>related.slug!==tool.slug).slice(0,6).map(related=><a class="platform-tool-card" href={`/tools/${related.slug}/`}><h3>{related.name}</h3><p>{related.description}</p></a>)}</div><p><a href="/tools/">Explore all barcode tools</a> · <a href="/solutions/retail/">Retail workflow</a> · <a href="/docs/">Developer documentation</a></p></div></section></BaseLayout>
<style>.tool-faq{border-top:1px solid var(--line);padding:20px 0}.tool-faq summary{font-weight:600;cursor:pointer}.platform-tool-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.platform-tool-card{background:var(--white);border:1px solid var(--line);border-radius:var(--radius);padding:20px}.platform-tool-card h3{font-size:21px}.platform-tool-card p{font-size:15px;color:var(--muted)}li{margin:16px 0}@media(max-width:800px){.platform-tool-grid{grid-template-columns:1fr 1fr}}@media(max-width:500px){.platform-tool-grid{grid-template-columns:1fr}}</style>
