---
import BaseLayout from "../../layouts/BaseLayout.astro";
const solutions={retail:["Retail and Small Businesses","Keep product identifiers and useful details together.","Scan incoming products, save your own notes and prices, and print labels from your Vault."],warehouses:["Warehouses and Inventory","Bring reliable identifiers to your receiving workflow.","Read package identifiers, validate supplier data and prepare consistent product labels. Track quantities, stock movements, low-stock thresholds and purchase valuation in Inventory Manager."],ecommerce:["E-commerce Businesses","Prepare product data for your next catalogue task.","Enrich available product names and brands, keep private product records, and export reviewed collections."],assets:["Asset Management","Create clear identifiers for your internal items.","Use internal Code 128 or QR identifiers, store item details and print labels. Track check-in/out, movements and maintenance history in Asset Tracker on Starter and Growth."],developers:["Developers","Connect barcode tools to your software.","Use authenticated lookup, rendering and decoding APIs with separate allowances and predictable responses."]};
export function getStaticPaths(){return ["retail","warehouses","ecommerce","assets","developers"].map(solution=>({params:{solution}}));}
const key=Astro.params.solution as keyof typeof solutions;const [name,heading,description]=solutions[key];
---
<BaseLayout title={`${name} Barcode Tools & Workflows | BarcodeNest`} description={description} current="solutions"><header class="tool-hero container"><div class="eyebrow">{name}</div><h1>{heading}</h1><p class="lede">{description}</p><div class="hero-actions"><a class="button button-signal" href="/register/?next=%2Fworkspace%2F">Get Started Free</a><a class="button button-secondary" href="/tools/">Explore Tools</a></div></header><section class="section narrow"><h2>Start with the tools that are available now</h2><p><a href="/barcode-scanner/">Scan an identifier</a>, <a href="/barcode-lookup/">look up available product data</a>, and keep reviewed details in your <a href="/vault/">private Vault</a>. Generate images and PDF labels when you need them.</p><p><a href="/tools/barcode-inventory/">Inventory management</a> · <a href="/tools/barcode-asset-tracking/">Asset tracking</a> · <a href="/tools/barcode-label-maker/">Label Studio</a> · <a href="/tools/product-catalogue/">Product Catalogue</a></p><h2>Choose a plan for your workload</h2><p>Free includes 25 saved records and basic tool allowances. Paid plans add larger capacities and exports. Product coverage varies and an internal identifier is not a registered GS1 GTIN. <a href="/pricing/">Compare plans and current limits</a>.</p><h2>Can I connect my existing systems?</h2><p>Yes. Read the <a href="/docs/">API documentation</a> for integration endpoints, authentication and quotas.</p></section></BaseLayout><style>.tool-hero{padding:64px 0 24px}</style>
