---
import SeoApiPage from "../components/SeoApiPage.astro";
const response = `{
  "barcode": "3017620422003",
  "barcode_type": "EAN-13",
  "canonical_gtin": "03017620422003",
  "valid": true,
  "found": true,
  "product": { "name": "Nutella", "brand": "Ferrero" }
}`;
const sections = [
  { heading: "EAN lookup for global grocery products", paragraphs: ["EAN identifiers are widely used on consumer products outside North America. BarcodeNest provides an EAN lookup API that accepts EAN-8 and EAN-13 codes, validates their check digits, and searches a global grocery product index with particularly strong European coverage.", "Applications receive a consistent JSON envelope containing barcode metadata, the lookup result, available product information, and source metadata. The endpoint is useful when an application needs to translate a scanned EAN into product identity without maintaining its own normalized database."] },
  { heading: "EAN-8 and EAN-13 support", paragraphs: ["EAN-8 is an eight-digit compact identifier, while EAN-13 is the common 13-digit format seen across international retail. Both formats belong to the wider GTIN family. BarcodeNest zero-pads valid EAN identifiers to a canonical GTIN-14 representation for matching.", "Input must contain ASCII digits, use a supported length, and pass the standard check-digit calculation. Invalid values and valid-but-not-indexed products produce different errors so integrations can decide whether to correct input, ask the user, or continue without product details."] },
  { heading: "Product fields and coverage", paragraphs: ["Available EAN product data can include name, brand, quantity, categories, countries, ingredients, allergens, nutrition, and an image URL. Field availability varies, and client applications should treat optional values as nullable.", "The index currently contains more than 4.2 million grocery products derived initially from Open Food Facts. BarcodeNest supplies the indexed, normalized API service layer and keeps source provenance visible; it does not claim ownership of Open Food Facts data."] },
];
---
<SeoApiPage title="EAN Lookup API | EAN-8 & EAN-13 Product Data | BarcodeNest" description="Search EAN-8 and EAN-13 grocery products with BarcodeNest's EAN lookup API and retrieve normalized product information as JSON." eyebrow="EAN lookup API" heading="EAN-8 and EAN-13 lookup API" intro="Turn European and international EAN barcodes into structured grocery product data with one authenticated request." sections={sections} response={response} related={[["General barcode API", "/barcode-api/"], ["UPC lookup API", "/upc-api/"], ["GTIN lookup API", "/gtin-api/"], ["Barcode lookup guide", "/docs/barcode-lookup/"]]} />
