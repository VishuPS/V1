---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolAccessGate from "../components/ToolAccessGate.astro";
import "../styles/barcode-tools.css";
---
<BaseLayout title="Online Barcode Lookup: UPC, EAN & GTIN Products | BarcodeNest" description="Look up available product names and brands by UPC, EAN or GTIN, then save a private product record in BarcodeNest. Account and lookup allowance required."><header class="tool-hero container"><div class="eyebrow">Product discovery</div><h1>Look up a barcode. Keep what matters.</h1><p class="lede">Retrieve available product details, review the match and save it to your private Vault.</p></header><ToolAccessGate /><div class="tool-grid container"><section class="tool-card"><form id="lookup-form"><fieldset data-account-tool disabled><label for="lookup-value">UPC, EAN or GTIN</label><input id="lookup-value" required maxlength="64" inputmode="numeric" /><button class="button button-signal" type="submit">Look up product</button></fieldset></form><p class="tool-hint">Lookup allowance applies. Free uses a credit only for a successful match. Paid lookup plans count valid attempts. Creator does not include product lookup.</p></section><section class="tool-card"><h2 id="lookup-name">Product details</h2><p id="lookup-brand"></p><p id="lookup-status" role="status"></p><button id="lookup-save" class="button button-secondary" type="button" hidden>Save to Vault</button></section></div><section class="narrow section"><h2>What if my product is not found?</h2><p>A valid identifier may have no catalogue match. You can create a private record in <a href="/vault/">My Vault</a> using your own details. A lookup does not establish product authenticity or GS1 ownership.</p><h2>More ways to work</h2><p><a href="/barcode-scanner/">Scan a photo</a>, <a href="/barcode-validator/">validate the number</a> or <a href="/docs/barcode-lookup/">integrate the API</a>. See <a href="/pricing/">plan allowances</a>.</p></section></BaseLayout>
<script>import{authFetch,responseMessage}from'../scripts/auth-context';import{saveToVault}from'../scripts/vault-client';let draft:any=null;const status=document.getElementById('lookup-status')!,save=document.getElementById('lookup-save')as HTMLButtonElement;document.getElementById('lookup-form')!.addEventListener('submit',async event=>{event.preventDefault();const button=document.querySelector<HTMLButtonElement>('#lookup-form button')!;button.disabled=true;save.hidden=true;status.textContent='Looking up product…';try{const value=(document.getElementById('lookup-value')as HTMLInputElement).value;const response=await authFetch('/account/products/'+encodeURIComponent(value));if(!response.ok)throw new Error(await responseMessage(response));const data=await response.json(),product=data.product;document.getElementById('lookup-name')!.textContent=product.name;document.getElementById('lookup-brand')!.textContent=product.brand||'';draft={barcode:data.barcode,name:product.name.slice(0,200),brand:(product.brand||'').slice(0,200),image_url:product.image_url?.startsWith('https://')?product.image_url:''};save.hidden=false;save.disabled=false;status.textContent='Review the product and save it if it matches your item.';}catch(error){status.textContent=error instanceof Error?error.message:'Lookup unavailable.';}finally{button.disabled=false;}});save.addEventListener('click',async()=>{save.disabled=true;try{const result=await saveToVault(draft);status.textContent=result.created?'Saved to your private Vault.':'Already saved. Existing details were kept.';}catch(error){status.textContent=error instanceof Error?error.message:'Save unavailable.';save.disabled=false;}});</script>
