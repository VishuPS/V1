---
import AccountLayout from "../layouts/AccountLayout.astro";
---
<AccountLayout title="API keys" current="api-keys">
  <header class="portal-header"><div><div class="eyebrow">Credentials</div><h1>API keys</h1><p>Create, regenerate, and revoke keys for your applications.</p></div></header>
  <section class="portal-panel"><div class="keys-head"><div><span class="panel-label">Your credentials</span><h2>Production access</h2><p>Full keys are never stored or displayed again after creation.</p></div><form id="create-key-form" class="key-create-form"><label for="key-name">Key name</label><div><input id="key-name" name="name" value="production" required maxlength="128"><button class="button" type="submit">Create API key</button></div></form></div><div id="new-key" class="key-result" hidden><div class="code-toolbar"><span>API key &middot; copy now, shown once</span><button id="copy-new-key" class="copy-button" type="button">Copy key</button></div><pre><code></code></pre></div><div id="keys-list" class="keys-list"><p class="empty-state">Loading API keys&hellip;</p></div></section>
  <div id="keys-status" class="form-status" role="status" aria-live="polite"></div>
  <script>
    import { authFetch, requireUser } from "../scripts/auth-context";
    const status = document.getElementById("keys-status");
    function message(value: string, error = false) { if (status) { status.className = `form-status${error ? " error" : ""}`; status.textContent = value; } }
    function showNewKey(value: string) { const result = document.getElementById("new-key"); const code = result?.querySelector("code"); if (code) code.textContent = value; if (result) result.hidden = false; result?.scrollIntoView({ behavior: "smooth", block: "nearest" }); }
    function renderKeys(keys: Array<any>) { const list = document.getElementById("keys-list"); if (!list) return; list.replaceChildren(); if (!keys.length) { list.innerHTML = '<p class="empty-state">No API keys yet. Create one to make your first lookup.</p>'; return; } for (const key of keys) { const row = document.createElement("div"); row.className = "key-row"; const info = document.createElement("div"); const name = document.createElement("strong"); name.textContent = key.name || "Unnamed key"; const meta = document.createElement("span"); meta.textContent = `${key.key_prefix} · ${key.active ? "Active" : "Revoked"}${key.last_used_at ? ` · Used ${new Intl.DateTimeFormat("en", { dateStyle: "medium" }).format(new Date(key.last_used_at))}` : " · Never used"}`; info.append(name, meta); row.append(info); if (key.active) { const actions = document.createElement("div"); actions.className = "key-actions"; for (const [action, label] of [["regenerate", "Regenerate"], ["revoke", "Revoke"]]) { const button = document.createElement("button"); button.type = "button"; button.className = `text-button ${action === "regenerate" ? "regenerate-button" : ""}`; button.textContent = label; button.dataset.keyId = key.id; button.dataset.action = action; actions.append(button); } row.append(actions); } list.append(row); } }
    async function reloadKeys() { const response = await authFetch("/account/api-keys"); if (!response.ok) { message("API keys could not be loaded. Please refresh to try again.", true); return; } renderKeys(await response.json()); }
    async function load() { if (!await requireUser()) return; await reloadKeys(); }
    document.getElementById("create-key-form")?.addEventListener("submit", async (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; if (!form.reportValidity()) return; const button = form.querySelector<HTMLButtonElement>('button[type="submit"]'); if (button) button.disabled = true; const response = await authFetch("/account/api-keys", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name: new FormData(form).get("name") }) }); if (button) button.disabled = false; if (!response.ok) { message("The API key could not be created.", true); return; } const key = await response.json(); showNewKey(key.api_key); message("API key created. Copy it now; it will not be shown again."); await reloadKeys(); });
    document.getElementById("copy-new-key")?.addEventListener("click", async () => { const value = document.querySelector("#new-key code")?.textContent; if (value) { await navigator.clipboard.writeText(value); message("API key copied."); } });
    document.getElementById("keys-list")?.addEventListener("click", async (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-key-id]"); if (!button) return; const regenerate = button.dataset.action === "regenerate"; const prompt = regenerate ? "Regenerate this key? The current key will stop working immediately." : "Revoke this key? Applications using it will stop working."; if (!confirm(prompt)) return; button.disabled = true; const response = await authFetch(regenerate ? `/account/api-keys/${button.dataset.keyId}/regenerate` : `/account/api-keys/${button.dataset.keyId}`, { method: regenerate ? "POST" : "DELETE" }); if (!response.ok) { button.disabled = false; message(`The API key could not be ${regenerate ? "regenerated" : "revoked"}.`, true); return; } if (regenerate) { const key = await response.json(); showNewKey(key.api_key); message("Replacement key created. Copy it now; it will not be shown again."); } else message("API key revoked."); await reloadKeys(); });
    load();
  </script>
</AccountLayout>
