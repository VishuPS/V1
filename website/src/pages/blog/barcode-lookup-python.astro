import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
const install = "python -m pip install requests";
const example = `import os
import requests


def lookup_product(barcode: str):
    # Keep identifiers as strings: leading zeros are meaningful.
    if not isinstance(barcode, str):
        raise TypeError("Pass the barcode as a string")
    barcode = barcode.strip()
    if not (barcode.isascii() and barcode.isdigit()
            and len(barcode) in (8, 12, 13, 14)):
        raise ValueError("Expected 8, 12, 13, or 14 ASCII digits")

    response = requests.get(
        f"https://api.barcodenest.com/v1/products/{barcode}",
        headers={"X-API-Key": os.environ["BARCODENEST_API_KEY"]},
        timeout=(5, 30),
    )
    if response.status_code == 404:
        return None
    # Authentication, invalid check digits, quota and server errors
    # remain errors; do not silently label them as missing products.
    response.raise_for_status()
    return response.json()


if __name__ == "__main__":
    result = lookup_product("3017620422003")
    if result is None:
        print("No product record found for this barcode.")
    else:
        product = result.get("product") or {}
        print("Name:", product.get("name") or "Not available")
        print("Brand:", product.get("brand") or "Not available")
        print("Image:", product.get("image_url") or "Not available")`;
