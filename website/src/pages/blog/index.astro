---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "BarcodeNest Blog | Barcode, GTIN & Product Data Guides";
const description = "Practical guides on barcodes, GTINs, product data and the infrastructure behind reliable product lookup.";
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "BarcodeNest Blog",
  description,
  url: "https://barcodenest.com/blog/",
  hasPart: [
    {
      "@type": "Article",
      headline: "EU Digital Product Passport: What Businesses Need to Prepare for Now",
      url: "https://barcodenest.com/blog/eu-digital-product-passport-business-guide/",
      datePublished: "2026-09-05",
    },
    {
      "@type": "Article",
      headline: "What Is a Digital Product Passport? Everything You Need to Know for 2027",
      url: "https://barcodenest.com/blog/digital-product-passport-guide/",
      datePublished: "2026-09-04",
    },
    {
      "@type": "Article",
      headline: "GS1 Digital Link Explained: The Future of Product Barcodes",
      url: "https://barcodenest.com/blog/gs1-digital-link-explained/",
      datePublished: "2026-09-02",
    },
    {
      "@type": "Article",
      headline: "2D Barcodes Are Replacing Traditional Barcodes: What Changes in 2027?",
      url: "https://barcodenest.com/blog/2d-barcodes-2027/",
      datePublished: "2026-09-01",
    },
  ],
};
---
<BaseLayout title={title} description={description} current="blog" structuredData={collectionSchema}>
  <section class="blog-index-hero">
    <div class="container blog-index-grid">
      <div>
        <div class="eyebrow">Field notes for product builders</div>
        <h1>Signals behind<br />every scan.</h1>
      </div>
      <p class="lede">Clear, practical writing about barcode standards, product identity and the data infrastructure that connects physical products to software.</p>
    </div>
  </section>

  <section class="container blog-featured" aria-labelledby="latest-article">
    <a class="blog-card-visual" href="/blog/eu-digital-product-passport-business-guide/" aria-label="Read EU Digital Product Passport: What Businesses Need to Prepare for Now">
      <div class="readiness-card" aria-hidden="true">
        <span>Data readiness / 2027</span>
        <div><b>01</b><strong>Identify</strong><i>✓</i></div><div><b>02</b><strong>Normalize</strong><i>✓</i></div><div><b>03</b><strong>Connect</strong><i>✓</i></div>
      </div>
      <span class="visual-caption">DPP preparation begins with consistent product identity.</span>
    </a>
    <article class="blog-card-copy">
      <div class="article-card-meta"><span>Business guide</span><time datetime="2026-09-05">Sep 5, 2026</time><span>7 min read</span></div>
      <h2 id="latest-article"><a href="/blog/eu-digital-product-passport-business-guide/">EU Digital Product Passport: what businesses need to prepare for now</a></h2>
      <p>Who may be affected, how the staged EU roadmap works, and why clean identifiers and product data should come before the QR code.</p>
      <a class="text-link" href="/blog/eu-digital-product-passport-business-guide/">Read the article <span aria-hidden="true">→</span></a>
    </article>
  </section>

  <section class="container blog-archive" aria-labelledby="all-articles">
    <div class="blog-archive-head"><div><div class="eyebrow">Archive</div><h2 id="all-articles">All field notes</h2></div><span>04 articles</span></div>
    <a class="blog-archive-row" href="/blog/digital-product-passport-guide/">
      <div class="article-card-meta"><span>Product identity</span><time datetime="2026-09-04">Sep 4, 2026</time><span>7 min read</span></div>
      <h3>What is a Digital Product Passport? Everything you need to know for 2027</h3>
      <span class="archive-arrow" aria-hidden="true">→</span>
    </a>
    <a class="blog-archive-row" href="/blog/gs1-digital-link-explained/">
      <div class="article-card-meta"><span>Standards</span><time datetime="2026-09-02">Sep 2, 2026</time><span>6 min read</span></div>
      <h3>GS1 Digital Link explained: the future of product barcodes</h3>
      <span class="archive-arrow" aria-hidden="true">→</span>
    </a>
    <a class="blog-archive-row" href="/blog/2d-barcodes-2027/">
      <div class="article-card-meta"><span>Standards</span><time datetime="2026-09-01">Sep 1, 2026</time><span>8 min read</span></div>
      <h3>2D barcodes are replacing traditional barcodes: what changes in 2027?</h3>
      <span class="archive-arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <section class="blog-index-note">
    <div class="container"><span>04 articles</span><p>More field notes on product identity, coverage and barcode lookup are on the way.</p></div>
  </section>
</BaseLayout>
