---
import AccountLayout from "../layouts/AccountLayout.astro";
---
<AccountLayout title="Account" current="account"><header class="portal-header"><div><div class="eyebrow">Account</div><h1>Account overview</h1><p>Access and account status for your BarcodeNest workspace.</p></div></header><div class="portal-grid"><section class="portal-panel"><span class="panel-label">Account status</span><h2 id="account-status-heading">&mdash;</h2><p id="account-status-copy">Checking account access&hellip;</p></section><section class="portal-panel"><span class="panel-label">Developer access</span><h2 id="account-key-status">&mdash;</h2><p>API keys are stored as one-way hashes and full values are only shown once.</p><a href="/api-keys/">Manage credentials &rarr;</a></section></div><section class="portal-section"><span class="panel-label">Account identifier</span><dl class="detail-list compact"><div><dt>User ID</dt><dd id="account-id">&mdash;</dd></div><div><dt>Email</dt><dd id="account-email">&mdash;</dd></div><div><dt>Plan</dt><dd id="account-plan">&mdash;</dd></div></dl></section><script>import { requireUser } from "../scripts/auth-context"; const set=(id:string,value:string)=>{const node=document.getElementById(id);if(node)node.textContent=value}; async function load(){const user=await requireUser();if(!user)return;set("account-status-heading",user.account_status === "active"?"Active":"Disabled");set("account-status-copy",user.account_status === "active"?"Your account can access BarcodeNest services.":"Your account access is currently disabled.");set("account-key-status",user.api_key_status === "active"?"Active key":"No active key");set("account-id",user.id);set("account-email",user.email);set("account-plan",user.current_plan);} load();</script></AccountLayout>
