---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Account - BarcodeNest" description="Manage your BarcodeNest API keys and usage.">
  <section class="account-page"><div class="container">
    <div id="account-loading" class="account-loading" role="status">Loading your account...</div>
    <div id="account-app" hidden>
      <header class="account-head"><div><div class="eyebrow">Developer dashboard</div><h1 id="account-name">Your account</h1><p id="account-email" class="lede"></p></div><div class="account-actions"><a id="admin-access" class="button button-secondary" href="/admin/" hidden>Admin dashboard</a><button id="logout" class="button button-secondary" type="button">Sign out</button></div></header>
      <div class="account-grid"><section class="account-panel"><span class="panel-label">Current month</span><h2><span id="usage-count">0</span> / <span id="usage-limit">500</span></h2><div class="usage-track" aria-hidden="true"><span id="usage-bar"></span></div><p id="usage-copy">Loading usage...</p></section><section class="account-panel"><span class="panel-label">Subscription</span><h2 id="plan-heading">Free</h2><p id="plan-status">Active</p><a href="/pricing/">Compare plans</a></section></div>
      <section class="keys-section"><div class="keys-head"><div><span class="panel-label">Credentials</span><h2>API keys</h2><p>Only prefixes are retained for display. New and regenerated keys are shown once.</p></div><form id="create-key-form" class="key-create-form"><label for="key-name">Key name</label><div><input id="key-name" name="name" value="production" required maxlength="128"><button class="button" type="submit">Create API key</button></div></form></div><div id="new-key" class="key-result" hidden><div class="code-toolbar"><span>API key &middot; copy now, shown once</span><button id="copy-new-key" class="copy-button" type="button">Copy key</button></div><pre><code></code></pre></div><div id="keys-list" class="keys-list"></div></section>
      <section class="account-start"><div><span class="panel-label">Quick start</span><h2>Make your next lookup.</h2><p>Use an active key in the <code>X-API-Key</code> header. Full keys are only shown when created or regenerated.</p></div><div class="account-start-actions"><a class="button" href="/docs/#quick-start">View quick start</a><a class="button button-secondary" href="/docs/">API documentation</a></div></section>
      <div id="account-status" class="form-status" role="status" aria-live="polite"></div>
    </div>
  </div></section>
  <script>
    const API = "https://api.barcodenest.com/v1"; const status = document.querySelector<HTMLElement>("#account-status");
    async function refreshSession() { return fetch(`${API}/auth/refresh`, { method: "POST", credentials: "include", headers: { "Content-Type": "application/json" }, body: "{}" }); }
    async function api(path: string, options: RequestInit = {}) { let response = await fetch(`${API}${path}`, { ...options, credentials: "include" }); if (response.status === 401 && !path.startsWith("/auth/")) { const refreshed = await refreshSession(); if (refreshed.ok) response = await fetch(`${API}${path}`, { ...options, credentials: "include" }); } return response; }
    function text(selector: string, value: string) { const node = document.querySelector<HTMLElement>(selector); if (node) node.textContent = value; }
    function renderKeys(keys: Array<any>) { const list = document.querySelector<HTMLElement>("#keys-list"); if (!list) return; list.replaceChildren(); if (!keys.length) { const empty = document.createElement("p"); empty.className = "empty-state"; empty.textContent = "No API keys yet. Create one to make your first lookup."; list.append(empty); return; } for (const key of keys) { const row = document.createElement("div"); row.className = "key-row"; const info = document.createElement("div"); const name = document.createElement("strong"); name.textContent = key.name || "Unnamed key"; const meta = document.createElement("span"); meta.textContent = `${key.key_prefix} · ${key.active ? "Active" : "Revoked"}`; info.append(name, meta); row.append(info); if (key.active) { const actions = document.createElement("div"); actions.className = "key-actions"; for (const [action, label] of [["regenerate", "Regenerate"], ["revoke", "Revoke"]]) { const button = document.createElement("button"); button.type = "button"; button.className = `text-button ${action === "regenerate" ? "regenerate-button" : ""}`; button.textContent = label; button.dataset.keyId = key.id; button.dataset.action = action; actions.append(button); } row.append(actions); } list.append(row); } }
    async function load() { const loading = document.querySelector<HTMLElement>("#account-loading"); try { const account = await api("/account"); if (account.status === 401) { location.assign(`/login/?next=${encodeURIComponent("/account/")}`); return; } if (!account.ok) throw new Error("Your account could not be loaded right now. Please refresh and try again."); const a = await account.json(); text("#account-name", a.display_name); text("#account-email", a.organization ? `${a.email} · ${a.organization}` : a.email); text("#plan-heading", a.plan || "Free"); const admin = document.querySelector<HTMLElement>("#admin-access"); if (admin && a.is_admin) admin.hidden = false; loading?.setAttribute("hidden", ""); const app = document.querySelector<HTMLElement>("#account-app"); if (app) app.hidden = false;
      const [usage, subscription, keys] = await Promise.all([api("/account/usage"), api("/account/subscription"), api("/account/api-keys")]); if (usage.ok) { const u = await usage.json(); text("#usage-count", String(u.lookup_count)); text("#usage-limit", String(u.monthly_limit)); text("#usage-copy", `${u.remaining} lookups remaining this month.`); const bar = document.querySelector<HTMLElement>("#usage-bar"); if (bar) bar.style.width = `${u.monthly_limit ? Math.min(100, u.lookup_count / u.monthly_limit * 100) : 0}%`; } else text("#usage-copy", "Usage is temporarily unavailable. Your API access is unaffected."); if (subscription.ok) { const p = await subscription.json(); text("#plan-heading", p.plan); text("#plan-status", p.status); } else text("#plan-status", "Plan details temporarily unavailable"); if (keys.ok) renderKeys(await keys.json()); else { renderKeys([]); if (status) { status.className = "form-status error"; status.textContent = "API keys could not be loaded. Refresh the page to try again."; } }
    } catch (error) { if (loading) { loading.className = "account-loading error"; loading.textContent = error instanceof Error ? error.message : "Your account could not be loaded."; } } }
    document.querySelector("#create-key-form")?.addEventListener("submit", async (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; if (!form.reportValidity()) return; const name = new FormData(form).get("name"); const response = await api("/account/api-keys", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name }) }); if (!response.ok) { if (status) status.textContent = "The API key could not be created."; return; } const key = await response.json(); const result = document.querySelector<HTMLElement>("#new-key"); const code = result?.querySelector("code"); if (code) code.textContent = key.api_key; if (result) result.hidden = false; const keys = await api("/account/api-keys"); if (keys.ok) renderKeys(await keys.json()); });
    document.querySelector("#copy-new-key")?.addEventListener("click", async () => { const value = document.querySelector("#new-key code")?.textContent; if (value) await navigator.clipboard.writeText(value); });
    document.querySelector("#keys-list")?.addEventListener("click", async (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-key-id]"); if (!button) return; const regenerate = button.dataset.action === "regenerate"; const warning = regenerate ? "Regenerate this API key? The current key will stop working immediately, and the replacement will be shown once." : "Revoke this API key? Applications using it will stop working."; if (!window.confirm(warning)) return; const response = await api(regenerate ? `/account/api-keys/${button.dataset.keyId}/regenerate` : `/account/api-keys/${button.dataset.keyId}`, { method: regenerate ? "POST" : "DELETE" }); if (!response.ok) { if (status) status.textContent = `The API key could not be ${regenerate ? "regenerated" : "revoked"}.`; return; } if (regenerate) { const key = await response.json(); const result = document.querySelector<HTMLElement>("#new-key"); const code = result?.querySelector("code"); if (code) code.textContent = key.api_key; if (result) result.hidden = false; } const keys = await api("/account/api-keys"); if (keys.ok) renderKeys(await keys.json()); });
    document.querySelector("#logout")?.addEventListener("click", async () => { await api("/auth/logout", { method: "POST" }); location.assign("/login/"); }); load();
  </script>
</BaseLayout>
