---
import BaseLayout from "../../layouts/BaseLayout.astro";
const template="gtin,product_name,brand,manufacturer,category,net_content,quantity,model,mpn,description,country_of_sale,product_url,image_url\n";
---
<BaseLayout title="Bulk Product Submission | BarcodeNest" description="Validate and submit up to 1,000 product catalogue rows for administrator review." current="contribute">
  <section class="page-hero contribution-hero"><div class="narrow"><div class="eyebrow">Bulk contribution</div><h1>Submit a product catalogue.</h1><p class="lede">Upload up to 1,000 UTF-8 CSV rows. Validated rows remain pending until an administrator approves the submission.</p></div></section>
  <section class="section"><div class="narrow contribution-layout"><form id="bulk-form" class="contribution-form"><div class="field"><label for="bulk-file">CSV file *</label><input id="bulk-file" type="file" accept=".csv,text/csv" required/><small>Maximum 1 MB and 1,000 data rows.</small></div><a class="button button-secondary" download="barcodenest-product-template.csv" href={`data:text/csv;charset=utf-8,${encodeURIComponent(template)}`}>Download CSV template</a><label class="consent"><input name="accepted_terms" type="checkbox" value="true" required/><span>I confirm I may submit this catalogue and agree to the <a href="/terms/#contributor-data">contributor data terms</a>.</span></label><button class="button button-signal" type="submit">Validate and submit</button><div id="bulk-status" class="form-status" role="status" aria-live="polite"></div></form><aside class="contribution-note"><span class="panel-label">Safe workflow</span><h2>Validate, preview, review.</h2><p>Rows never enter canonical products directly. Invalid rows are reported and valid rows are held for moderation.</p></aside></div></section>
  <script>
    import { authFetch,getAuthState,responseMessage } from "../../scripts/auth-context"; const form=document.querySelector<HTMLFormElement>("#bulk-form")!;const input=document.querySelector<HTMLInputElement>("#bulk-file")!;const status=document.querySelector<HTMLElement>("#bulk-status")!;form.addEventListener("submit",async(e)=>{e.preventDefault();if(!form.reportValidity())return;const file=input.files?.[0];if(!file)return;if(file.size>1_000_000){status.className="form-status error";status.textContent="CSV must be 1 MB or smaller.";return;}const auth=await getAuthState();if(auth.status!=="authenticated"){location.assign(`/login/?next=${encodeURIComponent(location.pathname)}`);return;}const response=await authFetch("/contributions/bulk",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({filename:file.name,csv_content:await file.text(),accepted_terms:true})});status.className=`form-status ${response.ok?"success":"error"}`;status.textContent=response.ok?"Catalogue submitted for administrator review.":await responseMessage(response);});
  </script>
</BaseLayout>
