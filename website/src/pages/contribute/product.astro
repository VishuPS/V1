---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Add a Missing Product | BarcodeNest" description="Validate a barcode and submit missing product information for administrator review." current="contribute">
  <section class="page-hero contribution-hero"><div class="narrow"><div class="eyebrow">Contributor ecosystem</div><h1>Add a missing product.</h1><p class="lede">Start with the barcode. BarcodeNest normalizes it and checks the canonical database before accepting product information.</p></div></section>
  <section class="section contribution-section"><div class="narrow contribution-layout"><form id="product-form" class="contribution-form" novalidate>
    <div class="field field-wide"><label for="barcode">Barcode *</label><div class="inline-field"><input id="barcode" name="barcode" inputmode="numeric" maxlength="32" required/><button class="button button-secondary" id="check-product" type="button">Check barcode</button></div><small>UPC-A, EAN-8, EAN-13, or GTIN-14 with a valid check digit.</small></div>
    <div id="existing-product" class="existing-product" hidden><strong>This product is already in BarcodeNest.</strong><p id="existing-product-copy"></p></div>
    <div id="product-fields" class="contribution-fields" hidden>
      <div class="field"><label for="product_name">Product name *</label><input id="product_name" name="product_name" maxlength="500" required/></div><div class="field"><label for="brand">Brand *</label><input id="brand" name="brand" maxlength="500" required/></div>
      <div class="field"><label for="manufacturer">Manufacturer</label><input id="manufacturer" name="manufacturer" maxlength="500"/></div><div class="field"><label for="category">Category</label><input id="category" name="category" maxlength="500"/></div>
      <div class="field"><label for="net_content">Net content / size</label><input id="net_content" name="net_content" maxlength="200"/></div><div class="field"><label for="quantity">Quantity</label><input id="quantity" name="quantity" maxlength="200"/></div>
      <div class="field"><label for="model">Model</label><input id="model" name="model" maxlength="200"/></div><div class="field"><label for="mpn">MPN</label><input id="mpn" name="mpn" maxlength="200"/></div>
      <div class="field"><label for="country_of_sale">Country of sale</label><input id="country_of_sale" name="country_of_sale" maxlength="120"/></div><div class="field"><label for="product_url">Evidence URL</label><input id="product_url" name="product_url" type="url" maxlength="2048"/></div>
      <div class="field field-wide"><label for="image_url">Image URL</label><input id="image_url" name="image_url" type="url" maxlength="2048"/></div><div class="field field-wide"><label for="description">Description</label><textarea id="description" name="description" maxlength="5000" rows="4"></textarea></div>
    </div>
    <label id="product-consent" class="consent" hidden><input name="accepted_terms" type="checkbox" value="true" required/><span>I confirm I may submit this information and agree to the <a href="/terms/#contributor-data">contributor data terms</a>.</span></label><p id="product-auth-note" class="contribution-auth-note" hidden>Sign-in is required only when you submit.</p><button class="button button-signal" id="submit-product" type="submit" hidden>Submit for review</button><div class="form-status" id="product-status" role="status" aria-live="polite"></div>
  </form><aside class="contribution-note"><span class="panel-label">Canonical data</span><h2>One product per GTIN.</h2><p>Equivalent UPC, EAN, and GTIN-14 representations resolve to the same identity. Public submissions remain pending until reviewed.</p></aside></div></section>
  <script>
    import { API, authFetch, getAuthState, responseMessage } from "../../scripts/auth-context";
    const form=document.querySelector<HTMLFormElement>("#product-form")!; const barcode=document.querySelector<HTMLInputElement>("#barcode")!; const fields=document.querySelector<HTMLElement>("#product-fields")!; const existing=document.querySelector<HTMLElement>("#existing-product")!; const status=document.querySelector<HTMLElement>("#product-status")!; const submit=document.querySelector<HTMLButtonElement>("#submit-product")!; const note=document.querySelector<HTMLElement>("#product-auth-note")!; const consent=document.querySelector<HTMLElement>("#product-consent")!; let checked="";
    const query=new URLSearchParams(location.search).get("gtin"); const saved=sessionStorage.getItem("barcodenest:contribution:product"); if(saved){try{const data=JSON.parse(saved);for(const [key,value] of Object.entries(data)){const input=form.elements.namedItem(key) as HTMLInputElement|null;if(input)input.value=String(value??"");}}catch{}} else if(query) barcode.value=query;
    async function check(){status.className="form-status";status.textContent="Checking the canonical database…";existing.hidden=true;fields.hidden=true;submit.hidden=true;note.hidden=true;consent.hidden=true;const response=await fetch(`${API}/contributions/products/check/${encodeURIComponent(barcode.value)}`);if(!response.ok){status.className="form-status error";status.textContent=await responseMessage(response);return;}const data=await response.json();checked=data.canonical_gtin;if(data.exists){existing.hidden=false;document.querySelector<HTMLElement>("#existing-product-copy")!.textContent=[data.product?.name,data.product?.brand].filter(Boolean).join(" · ");status.textContent="";return;}fields.hidden=false;submit.hidden=false;note.hidden=false;consent.hidden=false;status.className="form-status success";status.textContent=`Valid barcode · canonical GTIN ${data.canonical_gtin}. Know this product? Add it to BarcodeNest.`;}
    document.querySelector("#check-product")?.addEventListener("click",check); barcode.addEventListener("change",()=>{if(barcode.value!==checked){fields.hidden=true;submit.hidden=true;}}); if(barcode.value) check();
    form.addEventListener("submit",async(event)=>{event.preventDefault();if(!form.reportValidity()||!checked)return;const data={...Object.fromEntries(new FormData(form).entries()),accepted_terms:true};sessionStorage.setItem("barcodenest:contribution:product",JSON.stringify(data));const auth=await getAuthState();if(auth.status!=="authenticated"){location.assign(`/login/?next=${encodeURIComponent(location.pathname+location.search)}`);return;}submit.disabled=true;submit.textContent="Submitting…";const response=await authFetch("/contributions/products",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(data)});if(response.ok){sessionStorage.removeItem("barcodenest:contribution:product");form.reset();fields.hidden=true;submit.hidden=true;note.hidden=true;consent.hidden=true;status.className="form-status success";status.textContent="Product submitted for administrator review.";}else{status.className="form-status error";status.textContent=await responseMessage(response);}submit.disabled=false;submit.textContent="Submit for review";});
  </script>
</BaseLayout>
