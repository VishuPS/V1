---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContributionForm from "../../components/ContributionForm.astro";
const fields=[
  {name:"name",label:"Brand name",required:true,autocomplete:"organization"},{name:"company",label:"Company / manufacturer"},
  {name:"website",label:"Official website",type:"url",required:true,autocomplete:"url"},{name:"country",label:"Country",autocomplete:"country-name"},
  {name:"contact_name",label:"Contact name",autocomplete:"name"},{name:"business_email",label:"Business email",type:"email",autocomplete:"email"},
  {name:"logo_url",label:"Logo URL",type:"url"},{name:"description",label:"Description",type:"textarea",wide:true,max:3000},
];
---
<BaseLayout title="List Your Brand | BarcodeNest" description="Submit a brand or manufacturer profile for administrator-reviewed verification." current="contribute"><ContributionForm kind="brands" title="List your brand." intro="Register a brand or manufacturer and contribute first-party product information after administrator review." fields={fields}/></BaseLayout>
