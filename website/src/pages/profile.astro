---
import AccountLayout from "../layouts/AccountLayout.astro";
---
<AccountLayout title="Profile" current="profile"><header class="portal-header"><div><div class="eyebrow">Identity</div><h1>Profile</h1><p>Your personal and company information.</p></div></header><section class="portal-panel profile-panel"><dl class="detail-list"><div><dt>Name</dt><dd id="profile-name">&mdash;</dd></div><div><dt>Email</dt><dd id="profile-email">&mdash;</dd></div><div><dt>Company</dt><dd id="profile-company">&mdash;</dd></div><div><dt>Member since</dt><dd id="profile-created">&mdash;</dd></div></dl><p class="portal-note">To change account identity details, contact <a href="mailto:support@barcodenest.com">support@barcodenest.com</a>.</p></section><script>import { requireUser } from "../scripts/auth-context"; const set=(id:string,value:string)=>{const node=document.getElementById(id);if(node)node.textContent=value}; async function load(){const user=await requireUser();if(!user)return;set("profile-name",user.name);set("profile-email",user.email);set("profile-company",user.company||"Not provided");set("profile-created",new Intl.DateTimeFormat("en",{dateStyle:"long"}).format(new Date(user.created_at)));} load();</script></AccountLayout>
