---
import AccountLayout from "../layouts/AccountLayout.astro";
---
<AccountLayout title="Dashboard" current="dashboard">
  <header class="portal-header"><div><div class="eyebrow">Overview</div><h1 id="welcome">Welcome back.</h1><p>Your BarcodeNest account and API activity at a glance.</p></div><a id="admin-shortcut" class="button button-secondary" href="/admin/" hidden>Admin dashboard</a></header>
  <div class="portal-metrics"><article><span>Current plan</span><strong id="dashboard-plan">&mdash;</strong><small id="subscription-status">Loading subscription&hellip;</small></article><article><span>Monthly usage</span><strong><b id="usage-count">&mdash;</b> / <b id="usage-limit">&mdash;</b></strong><small id="usage-period">Current billing period</small></article><article><span>Remaining lookups</span><strong id="usage-remaining">&mdash;</strong><small>Available this month</small></article><article><span>API key</span><strong id="key-status">&mdash;</strong><small id="key-summary">Loading credentials&hellip;</small></article></div>
  <div class="portal-grid"><section id="usage-panel" class="portal-panel"><div class="panel-label">Usage</div><h2>Monthly API calls</h2><div class="usage-track" role="progressbar" aria-label="Monthly API usage" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="dashboard-usage-bar"></span></div><p id="usage-copy">Loading usage&hellip;</p><p id="usage-reset" class="portal-note"></p><a id="usage-upgrade" class="button button-secondary button-small" href="/billing/" hidden>Upgrade plan</a></section><section class="portal-panel"><div class="panel-label">Quick start</div><h2>Make a product request.</h2><p>Copy an active API key, then send it in the <code>X-API-Key</code> header.</p><a href="/docs/#quick-start">Open the quick start &rarr;</a></section></div>
  <section class="portal-section"><div class="portal-section-head"><div><span class="panel-label">Recent activity</span><h2>Credential activity</h2></div><a href="/api-keys/">Manage API keys</a></div><div id="recent-activity" class="activity-list"><p class="empty-state">Loading recent activity&hellip;</p></div></section>
  <div id="dashboard-status" class="form-status" role="status" aria-live="polite"></div>
  <script>
    import { authFetch, requireUser } from "../scripts/auth-context";
    const set = (id: string, value: string) => { const node = document.getElementById(id); if (node) node.textContent = value; };
    const formatDate = (value: string | null) => value ? new Intl.DateTimeFormat("en", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value)) : "Never used";
    async function loadDashboard() { const user = await requireUser(); if (!user) return; set("welcome", `Welcome, ${user.name.split(" ")[0]}.`); set("dashboard-plan", user.current_plan); set("key-status", user.api_key_status === "active" ? "Active" : user.api_key_status === "revoked" ? "Revoked" : "Not created"); const admin = document.getElementById("admin-shortcut"); if (admin && user.is_admin) admin.hidden = false;
      const [usageResponse, subscriptionResponse, keysResponse] = await Promise.all([authFetch("/account/usage"), authFetch("/account/subscription"), authFetch("/account/api-keys")]);
      if (usageResponse.ok) { const usage = await usageResponse.json(); set("usage-count", String(usage.lookup_count)); set("usage-limit", String(usage.monthly_limit)); set("usage-remaining", String(usage.remaining)); set("usage-period", `${usage.percentage_used}% used`); set("usage-copy", usage.blocked ? "Your monthly API allowance has been reached. Product requests are paused until reset or upgrade." : `${usage.lookup_count} of ${usage.monthly_limit} API calls used.`); set("usage-reset", usage.period_end ? `Allowance resets ${new Intl.DateTimeFormat("en", { dateStyle: "long" }).format(new Date(usage.period_end))}.` : ""); const bar = document.getElementById("dashboard-usage-bar"); const track = bar?.parentElement; if (bar) bar.style.width = `${Math.min(100, usage.percentage_used)}%`; if (track) track.setAttribute("aria-valuenow", String(Math.min(100, usage.percentage_used))); const panel=document.getElementById("usage-panel"); if(panel && usage.warning) panel.classList.add(usage.blocked?"usage-blocked":"usage-warning"); const upgrade=document.getElementById("usage-upgrade"); if(upgrade && usage.warning) upgrade.hidden=false; } else set("usage-copy", "Usage is temporarily unavailable.");
      if (subscriptionResponse.ok) { const subscription = await subscriptionResponse.json(); set("subscription-status", `${subscription.status} subscription`); } else set("subscription-status", "Plan details unavailable");
      const activity = document.getElementById("recent-activity"); if (keysResponse.ok && activity) { const keys = await keysResponse.json(); set("key-summary", `${keys.filter((key: any) => key.active).length} active credential${keys.filter((key: any) => key.active).length === 1 ? "" : "s"}`); activity.replaceChildren(); if (!keys.length) { activity.innerHTML = '<p class="empty-state">No API key activity yet.</p>'; } else for (const key of keys.slice(0, 5)) { const row = document.createElement("div"); row.className = "activity-row"; const copy = document.createElement("div"); const strong = document.createElement("strong"); strong.textContent = key.name || "Unnamed key"; const meta = document.createElement("span"); meta.textContent = `${key.key_prefix} · ${key.active ? "Active" : "Revoked"}`; copy.append(strong, meta); const time = document.createElement("time"); time.textContent = formatDate(key.last_used_at); row.append(copy, time); activity.append(row); } } else set("key-summary", "Credentials unavailable");
    }
    loadDashboard().catch(() => set("dashboard-status", "Dashboard data could not be loaded. Please refresh to try again."));
  </script>
</AccountLayout>
