---
import SeoApiPage from "../components/SeoApiPage.astro";
const response = `{
  "barcode": "3017620422003",
  "barcode_type": "EAN-13",
  "canonical_gtin": "03017620422003",
  "found": true,
  "product": {
    "name": "Nutella",
    "brand": "Ferrero",
    "quantity": "400 g"
  }
}`;
const sections = [
  { heading: "One REST API for product barcode lookup", paragraphs: ["BarcodeNest is a barcode lookup API for developers building grocery, inventory, nutrition, retail, and product catalogue applications. Submit a supported barcode to one predictable endpoint and receive a structured JSON response that is easier to integrate than raw source data.", "The API validates the identifier, converts it to a canonical GTIN-14 representation, and searches the indexed product database. A successful response can include identity, categories, quantity, countries, imagery, ingredients, allergens, and nutrition where the underlying record contains those fields."] },
  { heading: "Supported barcode formats", paragraphs: ["The lookup endpoint accepts UPC-A, EAN-8, EAN-13, and GTIN-14 identifiers with valid check digits. Canonical normalization means equivalent representations can resolve to the same product identity rather than becoming disconnected records."], items: ["UPC-A for 12-digit retail product identifiers", "EAN-8 for compact 8-digit identifiers", "EAN-13 for common international retail products", "GTIN-14 for 14-digit trade item identifiers"] },
  { heading: "Designed for production integrations", paragraphs: ["Requests use API-key authentication and return explicit HTTP status codes for invalid input, missing credentials, unknown products, rate limits, and monthly usage limits. Account holders can monitor usage and manage keys from the developer dashboard.", "BarcodeNest currently indexes more than 4.35 million food, beauty, pet food, and general products. Coverage and field completeness are not universal: availability depends on the product, geography, and source data. This explicit response model lets integrations distinguish an invalid barcode from a valid barcode that is not indexed."] },
];
---
<SeoApiPage title="Barcode API | Product Lookup REST API | BarcodeNest" description="Use the BarcodeNest barcode API to look up UPC, EAN and GTIN products through a fast REST endpoint with structured JSON responses." eyebrow="Barcode API" heading="Barcode API for structured product lookup" intro="Look up food, beauty, pet food, and general product information from UPC, EAN, and GTIN identifiers through one developer-friendly REST API." sections={sections} response={response} related={[["UPC lookup API", "/upc-api/"], ["EAN lookup API", "/ean-api/"], ["GTIN lookup API", "/gtin-api/"], ["Barcode lookup documentation", "/docs/barcode-lookup/"]]} />
