---
import AccountLayout from "../layouts/AccountLayout.astro";
---
<AccountLayout title="My Contributions" current="contributions">
  <header class="portal-header"><div><div class="eyebrow">Contributor ecosystem</div><h1>My contributions</h1><p>Track product, store, brand, and catalogue submissions.</p></div><a class="button button-signal" href="/contribute/">New contribution</a></header>
  <div class="portal-metrics contribution-metrics"><article><span>Pending</span><strong id="count-pending">—</strong><small>Awaiting review</small></article><article><span>Approved</span><strong id="count-approved">—</strong><small>Accepted</small></article><article><span>Needs changes</span><strong id="count-needs-changes">—</strong><small>Action requested</small></article><article><span>Rejected</span><strong id="count-rejected">—</strong><small>Not published</small></article></div>
  <section class="portal-section"><div class="portal-section-head"><div><span class="panel-label">Submission history</span><h2>Status</h2></div></div><div id="contribution-list" class="activity-list"><p class="empty-state">Loading contributions…</p></div></section><div id="contribution-status" class="form-status" role="status"></div>
  <script>
    import { authFetch,requireUser } from "../scripts/auth-context";const set=(id:string,value:number)=>{const node=document.getElementById(id);if(node)node.textContent=String(value||0)};async function load(){if(!await requireUser())return;const response=await authFetch("/contributions/mine");if(!response.ok)throw new Error("Contributions are temporarily unavailable.");const data=await response.json();set("count-pending",data.totals.PENDING);set("count-approved",data.totals.APPROVED);set("count-needs-changes",data.totals.NEEDS_CHANGES);set("count-rejected",data.totals.REJECTED);const list=document.querySelector<HTMLElement>("#contribution-list")!;list.replaceChildren();if(!data.items.length){list.innerHTML='<p class="empty-state">No contributions yet. Add a product, store, brand, or catalogue to get started.</p>';return;}for(const item of data.items){const row=document.createElement("div");row.className="activity-row";const copy=document.createElement("div");const strong=document.createElement("strong");strong.textContent=item.label;const meta=document.createElement("span");meta.textContent=`${item.type} · ${new Intl.DateTimeFormat("en",{dateStyle:"medium"}).format(new Date(item.created_at))}`;copy.append(strong,meta);const badge=document.createElement("span");badge.className=`admin-badge ${item.status==="APPROVED"?"success":item.status==="REJECTED"?"danger":"signal"}`;badge.textContent=item.status.replace("_"," ");row.append(copy,badge);if(item.contributor_message){const message=document.createElement("p");message.className="contributor-message";message.textContent=item.contributor_message;copy.append(message);}list.append(row);}}load().catch(error=>{document.querySelector<HTMLElement>("#contribution-status")!.textContent=error.message});
  </script>
</AccountLayout>
