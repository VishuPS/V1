---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Completing sign in - BarcodeNest" description="Completing secure BarcodeNest sign in." noindex={true}>
  <section class="auth-page"><div class="auth-shell"><div class="eyebrow">Secure sign in</div><h1>Finishing your account setup.</h1><p class="lede" id="oauth-status" role="status">Preparing your one-time API key…</p><noscript><p>JavaScript is required to finish OAuth onboarding. Return to <a href="/login/">sign in</a>.</p></noscript></div></section>
  <script>
    const params = new URLSearchParams(location.hash.slice(1));
    const key = params.get("api_key");
    history.replaceState({}, "", "/oauth-complete/");
    if (key) { sessionStorage.setItem("barcodenest_new_api_key", key); location.replace("/onboarding/"); }
    else { const status = document.querySelector<HTMLElement>("#oauth-status"); if (status) status.textContent = "The sign-in link is incomplete. Please return to sign in."; }
  </script>
</BaseLayout>
