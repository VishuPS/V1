---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---
<AdminLayout title="User details" current="users">
  <a class="admin-breadcrumb" href="/admin/users/">← Users</a>
  <header class="admin-header admin-user-header"><div><div class="eyebrow">User details</div><h1 id="user-name">Account</h1><p id="user-email"></p></div><div id="user-header-badges" class="admin-header-badges"></div></header>
  <div class="admin-detail-grid">
    <section class="admin-panel"><span class="panel-label">Profile</span><dl class="admin-definition"><div><dt>Company</dt><dd id="user-company">—</dd></div><div><dt>Registered</dt><dd id="user-created">—</dd></div><div><dt>Last login</dt><dd id="user-login">—</dd></div><div><dt>Plan</dt><dd id="user-plan">—</dd></div></dl></section>
    <section class="admin-panel"><span class="panel-label">Request statistics</span><div class="admin-stat-row"><div><strong id="requests-today">—</strong><span>Today</span></div><div><strong id="requests-month">—</strong><span>Requests this month</span></div><div><strong id="lookups-month">—</strong><span>Lookups this month</span></div></div></section>
  </div>
  <section class="admin-panel admin-keys-panel"><div class="admin-panel-head"><div><span class="panel-label">Credentials</span><h2>API keys</h2></div><button id="regenerate-primary" class="button button-secondary button-small" type="button">Regenerate active key</button></div><div id="admin-key-result" class="key-result" hidden><div class="code-toolbar"><span>Replacement key · copy now, shown once</span><button id="copy-admin-key" class="copy-button" type="button">Copy key</button></div><pre><code></code></pre></div><div id="user-keys" class="admin-key-list"></div></section>
  <div class="admin-detail-grid admin-lower-grid"><section class="admin-panel"><span class="panel-label">Subscription</span><div id="user-subscription" class="admin-subscription-placeholder">Billing is not connected.</div></section><section class="admin-panel"><span class="panel-label">Recent activity</span><ol id="user-activity" class="admin-activity"></ol></section></div>
  <section class="admin-panel admin-controls"><span class="panel-label">Administrative controls</span><div><div><strong>Account access</strong><p>Disable login and API access for this account.</p></div><button id="toggle-account" class="button button-secondary button-small" type="button"></button></div><div><div><strong>Administrator role</strong><p>Administrators can manage every BarcodeNest account.</p></div><button id="toggle-admin" class="button button-secondary button-small" type="button"></button></div></section>
  <div id="admin-status" class="form-status" role="status" aria-live="polite"></div>
  <script>
    import { adminFetch, formatDate, requireAdmin, responseMessage } from "../../../scripts/admin-api";
    const userId = new URLSearchParams(location.search).get("id"); let user: any;
    function text(id: string, value: string) { const node = document.getElementById(id); if (node) node.textContent = value; }
    function badge(value: string, tone: string) { const node = document.createElement("span"); node.className = `admin-badge ${tone}`; node.textContent = value; return node; }
    function render(data: any) { user = data; text("user-name", data.display_name); text("user-email", data.email); text("user-company", data.organization || "—"); text("user-created", formatDate(data.created_at, true)); text("user-login", formatDate(data.last_login_at, true)); text("user-plan", data.plan); text("requests-today", new Intl.NumberFormat().format(data.request_count_today)); text("requests-month", new Intl.NumberFormat().format(data.request_count_month)); text("lookups-month", new Intl.NumberFormat().format(data.lookup_count_month)); const badges = document.getElementById("user-header-badges"); if (badges) { badges.replaceChildren(); badges.append(badge(data.active ? "Active" : "Disabled", data.active ? "success" : "danger"), badge(data.is_admin ? "Admin" : "User", data.is_admin ? "signal" : "neutral")); } const account = document.querySelector<HTMLButtonElement>("#toggle-account"); if (account) account.textContent = data.active ? "Disable account" : "Enable account"; const admin = document.querySelector<HTMLButtonElement>("#toggle-admin"); if (admin) admin.textContent = data.is_admin ? "Demote admin" : "Promote to admin"; const keys = document.getElementById("user-keys"); if (keys) { keys.replaceChildren(); for (const key of data.api_keys) { const row = document.createElement("div"); const info = document.createElement("div"); const strong = document.createElement("strong"); strong.textContent = key.name || "Unnamed key"; const meta = document.createElement("span"); meta.textContent = `${key.key_prefix} · Created ${formatDate(key.created_at)} · ${key.last_used_at ? `Last used ${formatDate(key.last_used_at)}` : "Never used"}`; info.append(strong, meta); row.append(info, badge(key.active ? "Active" : "Revoked", key.active ? "success" : "neutral")); keys.append(row); } if (!data.api_keys.length) keys.textContent = "No API keys."; } const sub = document.getElementById("user-subscription"); if (sub) sub.textContent = data.subscription ? `${data.subscription.plan} · ${data.subscription.status}${data.subscription.provider ? ` via ${data.subscription.provider}` : ""}` : "No subscription record. Billing is not connected."; const activity = document.getElementById("user-activity"); if (activity) { activity.replaceChildren(); for (const item of data.recent_activity) { const li = document.createElement("li"); const label = document.createElement("span"); label.textContent = item.label; const time = document.createElement("time"); time.dateTime = item.occurred_at; time.textContent = formatDate(item.occurred_at, true); li.append(label, time); activity.append(li); } } }
    async function load(initial = false) { if (!userId) { location.assign("/admin/users/"); return; } const path = `/users/${encodeURIComponent(userId)}`; const response = initial ? await requireAdmin(path) : await adminFetch(path); if (!response) return; if (!response.ok) throw new Error(await responseMessage(response)); render(await response.json()); }
    async function action(path: string, body: object, confirmation: string) { if (!window.confirm(confirmation)) return; const status = document.getElementById("admin-status"); if (status) status.textContent = "Saving…"; const response = await adminFetch(path, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) }); if (!response.ok) throw new Error(await responseMessage(response)); if (status) { status.className = "form-status success"; status.textContent = "Changes saved."; } return response; }
    document.querySelector("#toggle-account")?.addEventListener("click", async () => { try { const response = await action(`/users/${userId}/status`, { active: !user.active }, `${user.active ? "Disable" : "Enable"} this account?${user.active ? " The user will be signed out and API access will stop immediately." : ""}`); if (response) render(await response.json()); } catch (error) { showError(error); } });
    document.querySelector("#toggle-admin")?.addEventListener("click", async () => { try { const response = await action(`/users/${userId}/admin-role`, { is_admin: !user.is_admin }, `${user.is_admin ? "Demote" : "Promote"} this user? This changes access to all customer administration tools.`); if (response) render(await response.json()); } catch (error) { showError(error); } });
    document.querySelector("#regenerate-primary")?.addEventListener("click", async () => { try { const response = await action(`/users/${userId}/api-keys/regenerate`, {}, "Regenerate this user's active API key? The current key will stop working immediately and the replacement is displayed only once."); if (!response) return; const data = await response.json(); const result = document.getElementById("admin-key-result"); const code = result?.querySelector("code"); if (code) code.textContent = data.api_key; if (result) result.hidden = false; await load(); } catch (error) { showError(error); } });
    document.querySelector("#copy-admin-key")?.addEventListener("click", async () => { const value = document.querySelector("#admin-key-result code")?.textContent; if (value) { await navigator.clipboard.writeText(value); const status = document.getElementById("admin-status"); if (status) { status.className = "form-status success"; status.textContent = "API key copied."; } } });
    function showError(error: unknown) { const status = document.getElementById("admin-status"); if (status) { status.className = "form-status error"; status.textContent = error instanceof Error ? error.message : "The action failed."; } }
    load(true).catch(showError);
  </script>
</AdminLayout>
