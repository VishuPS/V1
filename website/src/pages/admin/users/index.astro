---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---
<AdminLayout title="Users" current="users">
  <header class="admin-header"><div><div class="eyebrow">Accounts</div><h1>Users</h1><p id="users-count">Search and manage registered developers.</p></div></header>
  <form id="user-search" class="admin-search" role="search"><label for="search-users">Search users</label><div><input id="search-users" name="search" type="search" placeholder="Name, email or company" autocomplete="off"><button class="button" type="submit">Search</button></div></form>
  <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Name</th><th>Company</th><th>Registered</th><th>Plan</th><th>Usage</th><th>Subscription</th><th>API key</th><th>Role</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody id="users-body"></tbody></table></div>
  <div id="users-empty" class="admin-empty" hidden>No users match this search.</div>
  <nav class="admin-pagination" aria-label="User list pagination"><button id="users-previous" class="button button-secondary button-small" type="button">Previous</button><span id="users-page"></span><button id="users-next" class="button button-secondary button-small" type="button">Next</button></nav>
  <div id="admin-status" class="form-status" role="status" aria-live="polite"></div>
  <script>
    import { adminFetch, formatDate, requireAdmin } from "../../../scripts/admin-api";
    const pageSize=50; let offset=0; let currentSearch="";
    const cell=(value="—")=>{const td=document.createElement("td");td.textContent=value;return td};
    const badge=(value:string,tone:string)=>{const node=document.createElement("span");node.className=`admin-badge ${tone}`;node.textContent=value;return node};
    function render(data:any){const body=document.querySelector<HTMLTableSectionElement>("#users-body");if(!body)return;body.replaceChildren();for(const user of data.items){const row=document.createElement("tr");const identity=document.createElement("td");const name=document.createElement("strong");name.textContent=user.display_name;const email=document.createElement("span");email.textContent=user.email;identity.append(name,email);row.append(identity,cell(user.organization||"—"),cell(formatDate(user.created_at)),cell(user.plan),cell(`${new Intl.NumberFormat().format(user.usage)} / ${new Intl.NumberFormat().format(user.usage_limit)} (${user.usage_percentage}%)`));const subscription=document.createElement("td");subscription.append(badge(user.subscription_status,user.subscription_status==="active"?"success":user.subscription_status==="past_due"?"danger":"neutral"));row.append(subscription);const key=document.createElement("td");key.append(badge(user.api_key_status,user.api_key_status==="active"?"success":"neutral"));row.append(key);const role=document.createElement("td");role.append(badge(user.is_admin?"Admin":"User",user.is_admin?"signal":"neutral"));row.append(role);const status=document.createElement("td");status.append(badge(user.active?"Active":"Disabled",user.active?"success":"danger"));row.append(status);const action=document.createElement("td");const link=document.createElement("a");link.className="admin-row-link";link.href=`/admin/users/details/?id=${encodeURIComponent(user.id)}`;link.textContent="View";action.append(link);row.append(action);body.append(row);}document.querySelector<HTMLElement>("#users-empty")!.hidden=data.items.length>0;document.querySelector<HTMLElement>("#users-count")!.textContent=`${new Intl.NumberFormat().format(data.total)} registered ${data.total===1?"user":"users"}.`;document.querySelector<HTMLElement>("#users-page")!.textContent=`${Math.floor(offset/pageSize)+1} / ${Math.max(1,Math.ceil(data.total/pageSize))}`;document.querySelector<HTMLButtonElement>("#users-previous")!.disabled=offset===0;document.querySelector<HTMLButtonElement>("#users-next")!.disabled=offset+pageSize>=data.total;}
    async function loadUsers(initial=false){const path=`/users?limit=${pageSize}&offset=${offset}&search=${encodeURIComponent(currentSearch)}`;const response=initial?await requireAdmin(path):await adminFetch(path);if(!response)return;if(!response.ok)throw new Error("Users could not be loaded.");render(await response.json());}
    function showError(error:unknown){const status=document.querySelector<HTMLElement>("#admin-status");if(status){status.className="form-status error";status.textContent=error instanceof Error?error.message:"Users unavailable.";}}
    document.querySelector("#user-search")?.addEventListener("submit",event=>{event.preventDefault();currentSearch=String(new FormData(event.currentTarget as HTMLFormElement).get("search")||"").trim();offset=0;loadUsers().catch(showError);});
    document.querySelector("#users-previous")?.addEventListener("click",()=>{offset=Math.max(0,offset-pageSize);loadUsers().catch(showError);});document.querySelector("#users-next")?.addEventListener("click",()=>{offset+=pageSize;loadUsers().catch(showError);});loadUsers(true).catch(showError);
  </script>
</AdminLayout>
