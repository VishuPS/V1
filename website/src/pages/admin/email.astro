---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="Email" current="email">
  <header class="admin-header"><div><div class="eyebrow">Customer conversations</div><h1>Email</h1><p id="mail-address">support@barcodenest.com</p></div><div class="mail-header-links"><button id="mail-check" type="button" hidden>Check connection</button><a class="mail-webmail" href="https://www.spacemail.com/" target="_blank" rel="noopener noreferrer">Open Spacemail ↗</a></div></header>
  <div id="mail-status" class="mail-status" role="status" aria-live="polite"></div>
  <section id="mail-setup" class="mail-setup" hidden>
    <span class="panel-label">One step to connect</span><h2>Connect your support mailbox.</h2>
    <p>Your inbox will appear here once its mailbox password is added to the server.</p>
    <ol><li>Open the BarcodeNest service in Render and choose <strong>Environment → Edit</strong>.</li><li>Add <code>SUPPORT_MAIL_PASSWORD</code> with the password for <strong>support@barcodenest.com</strong>.</li><li>Save and deploy, then refresh this page. IMAP/SMTP access must be enabled in Spacemail.</li></ol>
    <a class="button" href="https://dashboard.render.com/web/srv-d9q74uu417fc73fmkk1g/env" target="_blank" rel="noopener noreferrer">Open Render settings ↗</a>
  </section>
  <section id="mail-workspace" class="mail-workspace" hidden aria-label="Support email">
    <aside class="mail-folders"><button id="mail-compose" class="button button-signal" type="button">Compose email</button><h2>Folders</h2><nav id="mail-folder-list" aria-label="Mailbox folders"></nav><p>Synced with Spacemail.<br/>Refresh to check for new mail.</p></aside>
    <div class="mail-conversations">
      <form id="mail-search" role="search"><label class="sr-only" for="mail-query">Search this folder</label><input id="mail-query" type="search" placeholder="Search this folder" maxlength="200"/><button type="submit" aria-label="Search email">Search</button></form>
      <div class="mail-list-heading"><h2 id="mail-folder-heading">Inbox</h2><button id="mail-refresh" type="button">Refresh</button></div>
      <div id="mail-list" class="mail-list" aria-live="polite"></div>
      <footer class="mail-pagination"><button id="mail-previous" type="button" disabled>Previous</button><span id="mail-page"></span><button id="mail-next" type="button" disabled>Next</button></footer>
    </div>
    <article class="mail-reader" aria-label="Message reader"><div id="mail-empty" class="mail-empty"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg><h2>Your conversations, in one place.</h2><p>Select a message to read it and reply.</p></div>
      <div id="mail-detail" hidden><div class="mail-reader-actions"><button id="mail-reply" type="button">Reply</button><button id="mail-forward" type="button">Forward</button><button id="mail-unread" type="button">Mark unread</button><label class="sr-only" for="mail-move-folder">Move message to folder</label><select id="mail-move-folder"><option value="">Move to…</option></select><button id="mail-move" type="button">Move</button></div><h2 id="mail-subject" tabindex="-1"></h2><dl class="mail-envelope"><dt>From</dt><dd id="mail-from"></dd><dt>To</dt><dd id="mail-to"></dd><dt>Cc</dt><dd id="mail-cc"></dd><dt>Date</dt><dd id="mail-date"></dd></dl><div id="mail-attachments" class="mail-attachments"></div><p class="mail-privacy">Messages are shown as text. Remote images are not loaded.</p><pre id="mail-body" class="mail-body"></pre></div>
    </article>
  </section>
  <dialog id="mail-editor" class="mail-editor" aria-labelledby="mail-editor-title"><form id="mail-editor-form"><div class="mail-editor-heading"><h2 id="mail-editor-title">New email</h2><button id="mail-editor-close" type="button" aria-label="Close composer">Close</button></div><p class="mail-from-note">From support@barcodenest.com</p><label for="mail-compose-to">To</label><input id="mail-compose-to" required maxlength="2000" placeholder="customer@example.com"/><label for="mail-compose-cc">Cc <span>(optional)</span></label><input id="mail-compose-cc" maxlength="2000"/><label for="mail-compose-subject">Subject</label><input id="mail-compose-subject" required maxlength="500"/><label for="mail-compose-body">Message</label><textarea id="mail-compose-body" rows="11" required maxlength="200000"></textarea><label for="mail-compose-files">Attachments <span>(8 MB total)</span></label><input id="mail-compose-files" type="file" multiple/><div id="mail-compose-status" role="status" aria-live="polite"></div><div class="mail-editor-footer"><p>Review recipients before sending.</p><button id="mail-send" class="button" type="submit">Send email</button></div></form></dialog>
  <script>
    import "../../scripts/admin-mail";
  </script>
</AdminLayout>
<style>
  .mail-header-links{display:flex;align-items:center;gap:16px;flex-wrap:wrap}#mail-check{border:1px solid var(--line);border-radius:5px;background:var(--white);min-height:40px;padding:6px 12px;font-size:12px;cursor:pointer}
  .mail-webmail{font-size:14px;text-decoration:underline;text-underline-offset:4px}.mail-status{margin-bottom:16px;white-space:pre-wrap}.mail-status.error,#mail-compose-status.error{color:#a22620}.mail-status.success{color:#34510e}.mail-setup{padding:32px;border:1px solid var(--line);border-radius:var(--radius);background:var(--white)}.mail-setup h2{font-size:25px}.mail-setup ol{padding-left:24px;line-height:1.9}.mail-setup code{font-size:14px;background:var(--paper-2);padding:3px 6px}
  .mail-workspace{display:grid;grid-template-columns:165px minmax(240px,310px) minmax(280px,1fr);background:var(--white);border:1px solid var(--line);border-radius:var(--radius);min-height:640px;overflow:hidden}.mail-folders{padding:18px 12px;background:var(--paper);border-right:1px solid var(--line)}.mail-folders>.button{padding:0 12px;width:100%;font-size:13px}.mail-folders h2{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin:28px 10px 8px}.mail-folders nav{display:grid;gap:4px}.mail-folders p{font-size:12px;line-height:1.7;color:var(--muted);margin:24px 10px}.mail-folders :global(nav button){border:0;background:transparent;text-align:left;padding:11px 10px;border-radius:5px;overflow-wrap:anywhere;min-height:44px;cursor:pointer;font-size:14px}.mail-folders :global(nav button[aria-current=page]){background:var(--paper-2);font-weight:650}.mail-conversations{border-right:1px solid var(--line);min-width:0}.mail-conversations form{display:flex;padding:14px 12px;gap:6px;border-bottom:1px solid var(--line)}.mail-conversations input{width:100%;min-width:0;font:inherit;font-size:13px;border:1px solid var(--line);border-radius:5px;background:var(--paper);padding:9px}.mail-workspace button:not(.button),.mail-editor button:not(.button){border:1px solid var(--line);border-radius:5px;background:var(--white);min-height:40px;padding:6px 10px;font-size:12px;cursor:pointer;color:var(--ink)}.mail-workspace button:hover,.mail-editor button:hover{background:var(--paper-2)}button:disabled{opacity:.5;cursor:wait}.mail-list-heading{display:flex;align-items:center;justify-content:space-between;padding:14px 12px}.mail-list-heading h2{font-size:16px;margin:0;overflow-wrap:anywhere}.mail-list{max-height:640px;overflow-y:auto;min-height:150px}.mail-list :global(.mail-row){display:grid!important;text-align:left!important;width:100%;border:0!important;border-radius:0!important;border-bottom:1px solid var(--line)!important;padding:14px!important;gap:5px;font-size:13px!important;background:var(--white);overflow-wrap:anywhere}.mail-list :global(.mail-row[aria-current=true]){background:var(--paper-2)!important;box-shadow:inset 3px 0 var(--ink)}.mail-list :global(.mail-row.unread){font-weight:650}.mail-list :global(.mail-row small){font-weight:400;color:var(--muted);font-size:11px}.mail-list :global(.mail-row span){font-size:12px;color:var(--muted);font-weight:400}.mail-pagination{display:flex;justify-content:space-between;align-items:center;gap:6px;padding:16px 10px;font-size:11px}.mail-reader{padding:24px;min-width:0}.mail-empty{display:grid;place-content:center;text-align:center;min-height:440px;color:var(--muted)}.mail-empty svg{margin:auto auto 12px}.mail-empty h2{font-size:20px;color:var(--ink)}.mail-empty p{font-size:14px}.mail-reader-actions{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:24px}.mail-reader-actions select{min-width:90px;max-width:150px;border:1px solid var(--line);border-radius:5px;background:var(--paper);font-size:12px}.mail-reader h2{font-size:23px;line-height:1.35;overflow-wrap:anywhere}.mail-envelope{display:grid;grid-template-columns:42px minmax(0,1fr);gap:5px 8px;font-size:12px;border-bottom:1px solid var(--line);padding-bottom:18px}.mail-envelope dt{color:var(--muted)}.mail-envelope dd{margin:0;overflow-wrap:anywhere}.mail-privacy{font-size:11px;color:var(--muted);margin-top:20px}.mail-body{white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;font:400 14px/1.8 "Geist",Arial,sans-serif;margin:18px 0;max-height:720px;overflow-y:auto}.mail-attachments{display:flex;flex-wrap:wrap;gap:6px}.mail-attachments :global(button){overflow-wrap:anywhere;max-width:100%;text-align:left}.mail-editor{width:min(720px,calc(100% - 24px));max-height:90vh;border:1px solid var(--line);border-radius:12px;background:var(--white);color:var(--ink);padding:26px}.mail-editor::backdrop{background:#171a1666}.mail-editor-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}.mail-editor h2{font-size:23px;margin:0}.mail-from-note{font-size:13px;color:var(--muted)}.mail-editor label{display:block;font-size:13px;font-weight:600;margin:14px 0 5px}.mail-editor label span{font-weight:400;color:var(--muted)}.mail-editor input:not([type=file]),.mail-editor textarea{width:100%;border:1px solid var(--line);border-radius:5px;background:var(--paper);padding:10px 12px;font:inherit;font-size:14px;color:var(--ink)}.mail-editor textarea{resize:vertical}.mail-editor input[type=file]{font-size:13px;max-width:100%}.mail-editor-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:18px}.mail-editor-footer p{font-size:12px;color:var(--muted)}#mail-compose-status{font-size:13px;white-space:pre-wrap;margin-top:12px}
  @media(min-width:1500px){.mail-workspace{grid-template-columns:175px 330px minmax(300px,1fr)}}@media(max-width:1200px){.mail-workspace{grid-template-columns:140px minmax(220px,1fr)}.mail-reader{grid-column:1/-1;border-top:1px solid var(--line);min-height:350px}.mail-conversations{border-right:0}.mail-list{max-height:360px}.mail-empty{min-height:240px}}@media(max-width:650px){.mail-workspace{grid-template-columns:1fr}.mail-folders{border-right:0;border-bottom:1px solid var(--line);padding:12px}.mail-folders nav{display:flex;flex-wrap:wrap;margin-top:10px}.mail-folders h2,.mail-folders p{display:none}.mail-folders>.button{width:auto}.mail-reader{padding:18px}.mail-list{max-height:310px}.mail-reader h2{font-size:20px}.mail-editor{padding:18px}.mail-editor-footer p{max-width:130px}}
</style>
