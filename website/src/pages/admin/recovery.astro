---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="Product recovery" current="recovery">
  <header class="admin-header"><div><div class="eyebrow">Coverage operations</div><h1>Product recovery</h1><p>Follow missing products from first request to local availability.</p></div><button id="recovery-refresh" class="button button-secondary" type="button">Refresh</button></header>
  <p id="recovery-config" class="portal-note">Loading recovery configuration…</p>
  <div class="admin-metrics" aria-label="All recovery jobs">
    {[["pending","Pending"],["running","Processing"],["retry","Awaiting retry"],["recovered","Recovered"],["unresolved","Unresolved"]].map(([key,label]) => <article><span>{label}</span><strong id={`recovery-${key}`}>—</strong><small>{key === "unresolved" ? "Attempt limit reached" : key === "recovered" ? "Available locally" : "Unique products"}</small></article>)}
  </div>
  <section class="admin-section">
    <div class="admin-section-heading"><div><span class="panel-label">Provider diagnostics</span><h2>What is blocking recovery?</h2><p>Latest stored checks for products not yet recovered. Checks can come from API lookups or background recovery; these are not provider uptime statistics.</p></div></div>
    <div id="recovery-providers" class="provider-grid"><p>Loading provider results…</p></div>
  </section>
  <section class="admin-section">
    <div class="admin-section-heading"><div><span class="panel-label">Recovery queue</span><h2>Missing products</h2></div><label for="recovery-filter">Status <select id="recovery-filter"><option value="">All statuses</option value="pending">Pending</option><option value="running">Processing</option><option value="retry">Awaiting retry</option><option value="recovered">Recovered</option><option value="unresolved">Unresolved</option></select></label></div>
    <p id="recovery-status" role="status" aria-live="polite">Loading recovery queue…</p>
    <div id="recovery-items" aria-busy="true"></div>
    <div class="recovery-pagination"><button class="button button-secondary" id="recovery-prev" type="button" disabled>Previous</button><span id="recovery-page"></span><button class="button button-secondary" id="recovery-next" type="button" disabled>Next</button></div>
    <p class="portal-note">Times are shown in your local timezone. Retry time is the earliest eligible time, not a guaranteed start. Temporary-only source matches are never added to the product database.</p>
  </section>
  <script>
    import { adminFetch, requireAdmin, formatDate } from "../../scripts/admin-api";
    type Check = {provider:string;status:string;detail:string|null;checked_at:string;expires_at:string};
    type Item = {canonical_gtin:string;status:string;request_count:number;attempts:number;last_seen:string;next_attempt:string|null;provider:string|null;reason:string;checks:Check[]};
    type Data = {generated_at:string;capture_enabled:boolean;worker_configured:boolean;counts:Record<string,number>;provider_summary:{provider:string;status:string;detail:string|null;products:number}[];total:number;items:Item[]};
    const labels:Record<string,string>={pending:"Pending",running:"Processing",retry:"Awaiting retry",recovered:"Recovered",unresolved:"Unresolved",miss:"No match",unavailable:"Unavailable",error:"Error",invalid:"Invalid data",found:"Source match"};
    const statusNode=document.getElementById("recovery-status")!;
    const itemsNode=document.getElementById("recovery-items")!;
    const filter=document.getElementById("recovery-filter") as HTMLSelectElement;
    const refresh=document.getElementById("recovery-refresh") as HTMLButtonElement;
    const prev=document.getElementById("recovery-prev") as HTMLButtonElement;
    const next=document.getElementById("recovery-next") as HTMLButtonElement;
    const number=new Intl.NumberFormat(); let offset=0; let total=0; let ready=false;
    function element(tag:string,text:string,cls="") { const node=document.createElement(tag); node.textContent=text; node.className=cls; return node; }
    function render(data:Data) {
      total=data.total;
      for(const [key,value] of Object.entries(data.counts)) {const node=document.getElementById(`recovery-${key}`); if(node) node.textContent=number.format(value);}
      document.getElementById("recovery-config")!.textContent=`Capture ${data.capture_enabled?"enabled":"disabled"} · Worker ${data.worker_configured?"configured":"disabled"}. Configuration does not confirm worker health. Updated ${formatDate(data.generated_at,true)}.`;
      const providers=document.getElementById("recovery-providers")!;
      providers.replaceChildren(...(data.provider_summary.length ? data.provider_summary.map(p=>{
        const card=element("article","","provider-card"); card.append(element("strong",p.provider),element("p",`${labels[p.status]||p.status} · ${number.format(p.products)} products`));
        if(p.detail) card.append(element("small",p.detail === "access_denied" ? "Access denied — check provider account or credentials" : p.detail)); return card;
      }) : [element("p","No source checks recorded for outstanding jobs.")]));
      itemsNode.replaceChildren(...data.items.map(item=>{
        const card=element("article","","recovery-card"); const head=element("div","","recovery-card-heading");
        head.append(element("h3",item.canonical_gtin),element("span",labels[item.status]||item.status,"recovery-badge")); card.append(head);
        card.append(element("p",item.reason),element("p",`${number.format(item.request_count)} requests · ${item.attempts}/5 attempts · Last requested ${formatDate(item.last_seen,true)}`,"portal-note"));
        card.append(element("p",item.next_attempt ? `${item.status==="running"?"Lease expires":"Next eligible retry"}: ${formatDate(item.next_attempt,true)}` : item.provider ? `Recovered from ${item.provider}` : "No automatic retry scheduled", "portal-note"));
        const details=document.createElement("details"); details.append(element("summary",`Latest provider checks (${item.checks.length})`));
        if(!item.checks.length) details.append(element("p","No provider checks recorded."));
        for(const check of item.checks) {const line=element("div","","recovery-check"); line.append(element("strong",check.provider),element("span",`${labels[check.status]||check.status}${check.detail?` · ${check.detail}`:""}`),element("small",`Checked ${formatDate(check.checked_at,true)} · Cache expires ${formatDate(check.expires_at,true)}`)); details.append(line);}
        card.append(details); return card;
      }));
      statusNode.textContent=data.items.length ? `${number.format(total)} matching products. Newest requests first.` : "No recovery jobs match this status.";
      document.getElementById("recovery-page")!.textContent=total ? `${offset+1}–${Math.min(offset+25,total)} of ${number.format(total)}` : "0 products";
    }
    async function load() {
      refresh.disabled=true;filter.disabled=true;prev.disabled=true;next.disabled=true;itemsNode.setAttribute("aria-busy","true");statusNode.textContent="Loading recovery queue…";
      try { const path=`/recovery?limit=25&offset=${offset}${filter.value?`&status=${encodeURIComponent(filter.value)}`:""}`;
        const response=ready ? await adminFetch(path) : await requireAdmin(path); if(!response) return;
        if(!response.ok) throw new Error("Recovery data could not be loaded. Refresh to try again."); ready=true; render(await response.json());
      } catch(error) {itemsNode.replaceChildren(); document.getElementById("recovery-config")!.textContent="Recovery data unavailable. Refresh to try again."; document.getElementById("recovery-providers")!.replaceChildren(element("p","Provider diagnostics unavailable.")); for(const key of ["pending","running","retry","recovered","unresolved"]) document.getElementById(`recovery-${key}`)!.textContent="—"; total=0; document.getElementById("recovery-page")!.textContent="";statusNode.textContent=error instanceof Error?error.message:"Recovery unavailable.";}
      finally {refresh.disabled=false;filter.disabled=false;prev.disabled=offset===0;next.disabled=offset+25>=total;itemsNode.setAttribute("aria-busy","false");}
    }
    refresh.addEventListener("click",()=>void load());filter.addEventListener("change",()=>{offset=0;void load();});prev.addEventListener("click",()=>{offset=Math.max(0,offset-25);void load();});next.addEventListener("click",()=>{offset+=25;void load();});void load();
  </script>
  <style>
    .provider-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px}.provider-card,.recovery-card{border:1px solid var(--line);border-radius:12px;padding:20px}.provider-card p{margin:8px 0}.provider-card small{overflow-wrap:anywhere}.recovery-card{margin:16px 0}.recovery-card-heading,.recovery-pagination{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}.recovery-card h3{margin:0;font-family:monospace;font-size:18px}.recovery-badge{font-size:14px;font-weight:600}.recovery-check{display:grid;gap:6px;padding:14px 0;border-top:1px solid var(--line);overflow-wrap:anywhere}summary{cursor:pointer;min-height:44px;padding:12px 0}select{min-height:44px;margin-left:8px;max-width:100%;padding:8px;border:1px solid var(--line);border-radius:6px;background:var(--paper);color:inherit}button:disabled{opacity:.55;cursor:default}.recovery-pagination{margin:20px 0}@media(max-width:600px){.provider-grid{grid-template-columns:1fr}.recovery-card{padding:16px}.admin-section-heading label{display:block;width:100%}select{margin:8px 0;display:block;width:100%}}
  </style>
</AdminLayout>
