---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---
<AdminLayout title="Contributions" current="contributions">
  <header class="admin-header"><div><div class="eyebrow">Moderation</div><h1>Contributions</h1><p>Review community, retailer, brand, and bulk catalogue submissions.</p></div></header>
  <div class="admin-metrics"><article><span>Pending products</span><strong id="pending-products">—</strong></article><article><span>Pending stores</span><strong id="pending-stores">—</strong></article><article><span>Pending brands</span><strong id="pending-brands">—</strong></article><article><span>Pending bulk</span><strong id="pending-bulk">—</strong></article></div>
  <section class="admin-section"><div class="admin-section-heading"><div><span class="panel-label">Review queue</span><h2>Pending submissions</h2></div><div class="contribution-tabs" role="group" aria-label="Contribution type"><button class="button button-small contribution-tab" data-kind="PRODUCT">Products</button><button class="button button-small button-secondary contribution-tab" data-kind="STORE">Stores</button><button class="button button-small button-secondary contribution-tab" data-kind="BRAND">Brands</button><button class="button button-small button-secondary contribution-tab" data-kind="BULK">Bulk</button></div></div><div id="moderation-list" class="moderation-list"><p>Loading queue…</p></div></section><div id="moderation-status" class="form-status" role="status" aria-live="polite"></div>
  <dialog id="review-dialog" class="review-dialog"><form method="dialog"><h2 id="review-title">Review contribution</h2><div id="review-data" class="review-data"></div><div class="field"><label for="review-message">Message to contributor</label><textarea id="review-message" maxlength="2000" rows="3"></textarea></div><div class="field"><label for="review-notes">Internal review notes</label><textarea id="review-notes" maxlength="5000" rows="3"></textarea></div><div class="review-actions"><button class="button button-signal" value="APPROVE">Approve</button><button class="button button-secondary" value="NEEDS_CHANGES">Request changes</button><button class="button button-secondary" value="REJECT">Reject</button><button class="button button-secondary" value="cancel">Cancel</button></div></form></dialog>
  <script>
    import { adminFetch,requireAdmin,responseMessage } from "../../../scripts/admin-api";let currentKind="PRODUCT";let current:any=null;const set=(id:string,value:number)=>{const n=document.getElementById(id);if(n)n.textContent=String(value)};const list=document.querySelector<HTMLElement>("#moderation-list")!;const dialog=document.querySelector<HTMLDialogElement>("#review-dialog")!;
    function renderData(data:any){const area=document.querySelector<HTMLElement>("#review-data")!;area.replaceChildren();for(const [key,value] of Object.entries(data)){if(["review_notes","reviewed_by_user_id","submitted_by_user_id"].includes(key)||value===null||typeof value==="object")continue;const row=document.createElement("div");const label=document.createElement("span");label.textContent=key.replaceAll("_"," ");const content=document.createElement("strong");content.textContent=String(value);row.append(label,content);area.append(row);}}
    async function loadKind(kind:string){currentKind=kind;document.querySelectorAll<HTMLButtonElement>(".contribution-tab").forEach(button=>button.classList.toggle("button-secondary",button.dataset.kind!==kind));const response=await adminFetch(`/contributions/${kind}?status=PENDING`);if(!response.ok)throw new Error(await responseMessage(response));const rows=await response.json();list.replaceChildren();if(!rows.length){list.innerHTML="<p class='admin-empty'>No pending submissions of this type.</p>";return;}for(const item of rows){const article=document.createElement("article");article.className="moderation-card";const body=document.createElement("div");const title=document.createElement("h3");title.textContent=item.label;const meta=document.createElement("p");meta.textContent=[item.secondary,item.contributor_name,new Intl.DateTimeFormat("en",{dateStyle:"medium"}).format(new Date(item.created_at))].filter(Boolean).join(" · ");body.append(title,meta);const button=document.createElement("button");button.className="button button-small";button.textContent="Review";button.onclick=()=>{current=item;document.querySelector<HTMLElement>("#review-title")!.textContent=`Review ${item.label}`;renderData(item.data);dialog.showModal();};article.append(body,button);list.append(article);}}
    dialog.addEventListener("close",async()=>{if(!current||dialog.returnValue==="cancel")return;const action=dialog.returnValue;if(!confirm(`${action.replace("_"," ")} this contribution?`))return;const response=await adminFetch(`/contributions/${currentKind}/${current.id}/review`,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({action,review_notes:(document.querySelector<HTMLTextAreaElement>("#review-notes")!).value,contributor_message:(document.querySelector<HTMLTextAreaElement>("#review-message")!).value})});const status=document.querySelector<HTMLElement>("#moderation-status")!;status.className=`form-status ${response.ok?"success":"error"}`;status.textContent=response.ok?"Contribution reviewed.":await responseMessage(response);if(response.ok){current=null;await init();}});
    async function init(){const response=await requireAdmin("/contributions/summary");if(!response)return;const summary=await response.json();set("pending-products",summary.pending_products);set("pending-stores",summary.pending_stores);set("pending-brands",summary.pending_brands);set("pending-bulk",summary.pending_bulk_submissions);await loadKind(currentKind);}document.querySelectorAll<HTMLButtonElement>(".contribution-tab").forEach(button=>button.addEventListener("click",()=>loadKind(button.dataset.kind!)));init().catch(error=>{document.querySelector<HTMLElement>("#moderation-status")!.textContent=error.message});
  </script>
</AdminLayout>
