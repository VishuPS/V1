---
import AccountLayout from "../layouts/AccountLayout.astro";
---
<AccountLayout title="Billing" current="billing"><header class="portal-header"><div><div class="eyebrow">Plan</div><h1>Billing</h1><p>Your current subscription and monthly API allowance.</p></div><a class="button button-secondary" href="/pricing/">Compare plans</a></header><section class="portal-panel"><dl class="detail-list"><div><dt>Current plan</dt><dd id="billing-plan">&mdash;</dd></div><div><dt>Subscription status</dt><dd id="billing-status">&mdash;</dd></div><div><dt>Monthly price</dt><dd id="billing-price">&mdash;</dd></div><div><dt>Allowance resets</dt><dd id="billing-period">&mdash;</dd></div></dl><div class="billing-actions"><button class="button" data-checkout="STARTER" type="button">Choose Starter · $9.99/month</button><button class="button" data-checkout="GROWTH" type="button">Choose Growth · $19.99/month</button><button id="billing-portal" class="button button-secondary" type="button" hidden>Manage billing</button></div></section><div id="billing-message" class="form-status" role="status" aria-live="polite"></div><script>import { authFetch,requireUser,responseMessage } from "../scripts/auth-context";const set=(id:string,value:string)=>{const node=document.getElementById(id);if(node)node.textContent=value};async function load(){const user=await requireUser();if(!user)return;set("billing-plan",user.current_plan);const response=await authFetch("/account/subscription");if(!response.ok){set("billing-status","Unavailable");set("billing-message","Subscription details are temporarily unavailable.");return;}const data=await response.json();set("billing-plan",data.plan);set("billing-status",data.status);set("billing-price",data.price_cents===0?"Free":new Intl.NumberFormat("en",{style:"currency",currency:data.currency}).format(data.price_cents/100));set("billing-period",new Intl.DateTimeFormat("en",{dateStyle:"long"}).format(new Date(data.usage_period_end)));const portal=document.querySelector<HTMLButtonElement>("#billing-portal");if(portal)portal.hidden=!data.provider_customer_id;}async function redirect(path:string,body?:object){set("billing-message","Opening secure billing…");const response=await authFetch(path,{method:"POST",headers:body?{"Content-Type":"application/json"}:undefined,body:body?JSON.stringify(body):undefined});if(!response.ok){set("billing-message",await responseMessage(response));return;}location.assign((await response.json()).url);}document.querySelectorAll<HTMLButtonElement>("[data-checkout]").forEach(button=>button.addEventListener("click",()=>redirect("/billing/checkout",{plan:button.dataset.checkout})));document.querySelector("#billing-portal")?.addEventListener("click",()=>redirect("/billing/portal"));load();</script></AccountLayout>
