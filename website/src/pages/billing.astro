---
import AccountLayout from "../layouts/AccountLayout.astro";
---
<AccountLayout title="Billing" current="billing"><header class="portal-header"><div><div class="eyebrow">Plan</div><h1>Billing</h1><p>Your current subscription and usage allowance.</p></div><a class="button button-secondary" href="/pricing/">Compare plans</a></header><section class="portal-panel"><dl class="detail-list"><div><dt>Current plan</dt><dd id="billing-plan">&mdash;</dd></div><div><dt>Subscription status</dt><dd id="billing-status">&mdash;</dd></div><div><dt>Monthly price</dt><dd id="billing-price">&mdash;</dd></div><div><dt>Current period ends</dt><dd id="billing-period">&mdash;</dd></div></dl><p class="portal-note">Self-service billing is not connected yet. For plan questions, contact <a href="mailto:support@barcodenest.com">support@barcodenest.com</a>.</p></section><div id="billing-message" class="form-status" role="status"></div><script>import { authFetch,requireUser } from "../scripts/auth-context";const set=(id:string,value:string)=>{const node=document.getElementById(id);if(node)node.textContent=value};async function load(){const user=await requireUser();if(!user)return;set("billing-plan",user.current_plan);const response=await authFetch("/account/subscription");if(!response.ok){set("billing-status","Unavailable");set("billing-message","Subscription details are temporarily unavailable.");return;}const data=await response.json();set("billing-plan",data.plan);set("billing-status",data.status);set("billing-price",data.price_cents===0?"Free":data.price_cents==null?"Contact us":new Intl.NumberFormat("en",{style:"currency",currency:data.currency}).format(data.price_cents/100));set("billing-period",data.current_period_end?new Intl.DateTimeFormat("en",{dateStyle:"long"}).format(new Date(data.current_period_end)):"No fixed end date");}load();</script></AccountLayout>
