---
import BaseLayout from "../layouts/BaseLayout.astro";
import ToolAccessGate from "../components/ToolAccessGate.astro";
import "../styles/barcode-tools.css";
const schema = {
  "@context": "https://schema.org", "@type": "WebApplication",
  name: "BarcodeNest Barcode Generator", applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any", url: "https://barcodenest.com/barcode-generator/",
  description: "Create EAN-13, UPC-A, Code 128 and QR images with an account. Paid plans include bulk ZIP exports.",
};
---
<BaseLayout title="Barcode Generator & Batch Creation API | BarcodeNest" description="Create UPC-A, EAN-13, Code 128 and QR barcode images with a BarcodeNest account. Free includes 100 images per month. Paid plans add bulk ZIP exports." structuredData={schema} current="tools">
  <header class="tool-hero container">
    <div class="eyebrow">Barcode generator</div>
    <h1>Create the barcodes your business needs.</h1>
    <p class="lede">Generate an SVG or PNG from your identifier. Create a Free account for 100 images per month, or choose Starter or Growth to export batches as ZIP files.</p>
  </header>
  <ToolAccessGate />
  <div class="tool-grid container">
    <section class="tool-card">
      <h2>Create a barcode</h2>
      <form id="generator"><fieldset data-account-tool disabled>
        <label for="symbology">Barcode type</label>
        <select id="symbology"><option value="ean13">EAN-13</option><option value="upca">UPC-A</option><option value="code128">Code 128</option><option value="qr">QR code</option></select>
        <label for="barcode-value">Barcode value</label>
        <input id="barcode-value" placeholder="e.g. 3017620422003" maxlength="500" required autocomplete="off" aria-describedby="generator-hint" />
        <p class="tool-hint" id="generator-hint">Enter the complete assigned number for UPC or EAN, including its check digit. Use Code 128 for internal identifiers.</p>
        <label for="image-format">Download format</label>
        <select id="image-format"><option value="png">PNG image</option><option value="svg">SVG vector</option></select>
        <div class="tool-actions"><button class="button button-signal" type="submit">Generate barcode · 1 image unit</button></div>
      </fieldset></form>
      <p id="generator-status" class="tool-status" role="status" aria-live="polite"></p>
      <p class="tool-hint">Each generated image uses one unit. Downloading that result again uses the same file. Obtain an assigned GTIN before creating a UPC or EAN for a retail product.</p>
    </section>
    <section class="tool-card" aria-label="Barcode preview">
      <div class="tool-preview"><img id="barcode-image" alt="Generated barcode preview" hidden /><p id="preview-empty">Your barcode will appear here after generation.</p></div>
      <div class="tool-actions"><a id="download-image" class="button button-secondary" hidden>Download barcode</a></div>
      <p id="generation-balance" class="tool-status" role="status" aria-live="polite">Sign in to see your remaining image allowance.</p>
      <p class="tool-hint">Keep the white margins when printing. Test the printed barcode with your scanner before use.</p>
    </section>
  </div>
  <section class="tool-reference container">
    <div class="tool-grid">
      <section class="tool-card">
        <h2>Create a batch and download one ZIP</h2>
        <p>Exclusive to Starter and Growth. Starter supports 25 images per request and 2,000 per month. Growth supports 100 per request and 10,000 per month.</p>
        <form id="batch-generator"><fieldset data-account-tool disabled>
          <label for="batch-values">One barcode value per line</label>
          <textarea id="batch-values" rows="5" maxlength="51000" required placeholder="3017620422003"></textarea>
          <label for="batch-type">Barcode type</label>
          <select id="batch-type"><option value="ean13">EAN-13</option><option value="upca">UPC-A</option><option value="code128">Code 128</option><option value="qr">QR code</option></select>
          <label for="batch-format">Image format</label>
          <select id="batch-format"><option value="png">PNG</option><option value="svg">SVG</option></select>
          <div class="tool-actions"><button class="button button-signal" type="submit">Generate ZIP batch</button></div>
        </fieldset></form>
        <p id="batch-status" class="tool-status" role="status" aria-live="polite"></p>
        <a id="download-batch" class="button button-secondary" hidden download="barcodes.zip">Download ZIP</a>
        <p><a href="/pricing/">Compare paid plans →</a></p>
      </section>
      <section class="tool-card">
        <h2>Choose an allowance that fits your workflow</h2>
        <table class="tool-table"><caption>Barcode creation allowances</caption><thead><tr><th>Plan</th><th>Images / month</th><th>ZIP batch</th></tr></thead><tbody><tr><th>Free</th><td>100</td><td>Single images</td></tr><tr><th>Starter</th><td>2,000</td><td>25 / request</td></tr><tr><th>Growth</th><td>10,000</td><td>100 / request</td></tr></tbody></table>
        <p>Each image in a ZIP uses one image unit from the same monthly generation balance. Account keys and website generation share this balance. It resets on the first day of each month at 00:00 UTC.</p>
        <div class="tool-links"><a href="/barcode-labels/">Print product labels</a><a href="/csv-product-enrichment/">Enrich a product CSV</a><a href="/docs/barcode-tools/">Generation API docs</a></div>
      </section>
    </div>
    <h2>Connect barcode creation to your product workflow</h2>
    <p>Use <a href="/barcode-api/">product lookup</a> to find available names, brands and images, then prepare labels for inventory or catalog work. Your supplied identifier determines the barcode image.</p>
  </section>
</BaseLayout>
<script>
  import { authFetch, getAuthState, responseMessage } from "../scripts/auth-context";
  const form = document.querySelector<HTMLFormElement>("#generator")!;
  const batchForm = document.querySelector<HTMLFormElement>("#batch-generator")!;
  const status = document.querySelector<HTMLElement>("#generator-status")!;
  const batchStatus = document.querySelector<HTMLElement>("#batch-status")!;
  const balance = document.querySelector<HTMLElement>("#generation-balance")!;
  let imageUrl = "", zipUrl = "";
  let busy = false;
  let batchMaximum = 0;
  async function refreshBalance() {
    const response = await authFetch("/account/services/usage");
    if (!response.ok) throw new Error(await responseMessage(response));
    const data = await response.json();
    batchMaximum = data.batch_generation_max;
    balance.textContent = data.categories.generation.remaining.toLocaleString() + " of " + data.categories.generation.limit.toLocaleString() + " image units remaining this month.";
  }
  getAuthState().then(async (auth) => {
    if (auth.status === "authenticated") {
      try { await refreshBalance(); } catch (error) { balance.textContent = error instanceof Error ? error.message : "Balance unavailable."; }
    }
  });
  async function generate(batch: boolean) {
    if (busy) return;
    const selectedForm = batch ? batchForm : form;
    if (!selectedForm.reportValidity()) return;
    const currentStatus = batch ? batchStatus : status;
    const download = document.querySelector<HTMLAnchorElement>(batch ? "#download-batch" : "#download-image")!;
    currentStatus.dataset.error = "false";
    download.hidden = true;
    busy = true;
    const buttons = document.querySelectorAll<HTMLButtonElement>("#generator button, #batch-generator button");
    buttons.forEach((button) => button.disabled = true);
    try {
      const account = await getAuthState();
      if (account.status !== "authenticated") throw new Error("Sign in or create an account to generate barcodes.");
      const format = document.querySelector<HTMLSelectElement>(batch ? "#batch-format" : "#image-format")!.value;
      const symbology = document.querySelector<HTMLSelectElement>(batch ? "#batch-type" : "#symbology")!.value;
      const values = batch
        ? document.querySelector<HTMLTextAreaElement>("#batch-values")!.value.split(/\r?\n/).map((value) => value.trim()).filter(Boolean)
        : [document.querySelector<HTMLInputElement>("#barcode-value")!.value];
      if (batch) {
        await refreshBalance();
        if (!batchMaximum) throw new Error("Choose Starter or Growth to unlock ZIP batch generation.");
        if (!values.length || values.length > batchMaximum) throw new Error("Enter between 1 and " + batchMaximum + " values for this plan.");
      }
      currentStatus.textContent = batch ? "Generating " + values.length + " images…" : "Generating your barcode…";
      const items = values.map((value) => ({ value, symbology, format }));
      const response = await authFetch(batch ? "/account/barcodes/batch-render" : "/account/barcodes/render", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify(batch ? { items } : items[0]),
      });
      if (!response.ok) throw new Error(await responseMessage(response));
      const url = URL.createObjectURL(await response.blob());
      if (batch) {
        if (zipUrl) URL.revokeObjectURL(zipUrl);
        zipUrl = url; download.download = "barcodes.zip";
      } else {
        if (imageUrl) URL.revokeObjectURL(imageUrl);
        imageUrl = url; download.download = "barcode." + format;
        const image = document.querySelector<HTMLImageElement>("#barcode-image")!;
        image.src = url; image.hidden = false;
        document.querySelector<HTMLElement>("#preview-empty")!.hidden = true;
      }
      download.href = url; download.hidden = false;
      currentStatus.textContent = batch ? "Your ZIP is ready. " + values.length + " image units used." : "Your barcode is ready. 1 image unit used.";
      try { await refreshBalance(); } catch { balance.textContent = "File ready. Refresh to update your balance."; }
    } catch (error) {
      currentStatus.dataset.error = "true";
      currentStatus.textContent = error instanceof Error ? error.message : "The request could not complete. Check your balance before retrying.";
    } finally {
      busy = false;
      buttons.forEach((button) => button.disabled = false);
    }
  }
  form.addEventListener("submit", (event) => { event.preventDefault(); generate(false); });
  batchForm.addEventListener("submit", (event) => { event.preventDefault(); generate(true); });
</script>
