---
import BaseLayout from "../layouts/BaseLayout.astro";import ToolAccessGate from "../components/ToolAccessGate.astro";import "../styles/barcode-tools.css";
---
<BaseLayout title="UPC, EAN & GTIN Barcode Converter | BarcodeNest" description="Check a retail barcode and show equivalent UPC, EAN and GTIN representations without inventing a new product identifier. Account required."><header class="tool-hero container"><div class="eyebrow">Identifier conversion</div><h1>Same product identifier. Compatible representations.</h1><p class="lede">Convert supported UPC and EAN representations to canonical GTIN-14. Only equivalent representations are returned.</p></header><ToolAccessGate /><section class="tool-card narrow"><form id="convert"><fieldset data-account-tool disabled><label for="convert-value">Retail barcode including check digit</label><input id="convert-value" required inputmode="numeric" maxlength="64" /><button class="button button-signal" type="submit">Show equivalents</button></fieldset></form><p id="convert-status" role="status"></p><ul id="convert-results"></ul></section><section class="narrow section"><h2>What does conversion mean?</h2><p>This changes the representation of an existing valid GTIN, not its ownership or product identity. A GTIN-14 with a non-zero packaging indicator cannot simply be shortened to an equivalent retail UPC. Arbitrary SKU-to-UPC conversion is not supported.</p><h2>Need an image instead?</h2><p>Use the <a href="/barcode-generator/">barcode generator</a> to encode an assigned identifier. Check a photo with the <a href="/barcode-scanner/">scanner</a> or save details in <a href="/vault/">My Vault</a>.</p></section></BaseLayout>
<script>import{authFetch,responseMessage}from'../scripts/auth-context';document.getElementById('convert')!.addEventListener('submit',async e=>{e.preventDefault();const button=document.querySelector<HTMLButtonElement>('#convert button')!,status=document.getElementById('convert-status')!,list=document.getElementById('convert-results')!;button.disabled=true;list.replaceChildren();try{const response=await authFetch('/account/barcodes/validate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({value:(document.getElementById('convert-value')as HTMLInputElement).value})});if(!response.ok)throw new Error(await responseMessage(response));const data=await response.json();if(!data.valid)throw new Error(data.error);for(const value of data.equivalents){const li=document.createElement('li');li.textContent=value;list.append(li);}status.textContent='Equivalent representations; leading zeros are preserved.';}catch(error){status.textContent=error instanceof Error?error.message:'Conversion unavailable.';}finally{button.disabled=false;}});</script>
