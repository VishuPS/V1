---
const { type } = Astro.props;
---
<section class="page-hero"><div class="narrow"><div class="eyebrow">BarcodeNest {type}</div><div id="profile-loading" class="form-status" role="status">Loading approved profile…</div><article id="public-profile" class="public-contributor-profile" hidden><img id="profile-logo" alt="" hidden/><h1 id="profile-name"></h1><p id="profile-description" class="lede"></p><dl class="detail-list"><div><dt>Country</dt><dd id="profile-country">—</dd></div><div><dt>Official website</dt><dd><a id="profile-website" rel="external nofollow">Visit website</a></dd></div></dl></article></div></section>
<script is:inline define:vars={{ type }}>
  const slug=location.pathname.split("/").filter(Boolean).at(-1);const loading=document.getElementById("profile-loading");const profile=document.getElementById("public-profile");
  fetch(`https://api.barcodenest.com/v1/contributions/${type}s/${encodeURIComponent(slug||"")}`).then(async response=>{if(!response.ok)throw new Error(`${type[0].toUpperCase()+type.slice(1)} not found.`);const data=await response.json();document.getElementById("profile-name").textContent=data.name;document.getElementById("profile-description").textContent=data.description||"Approved BarcodeNest contributor profile.";document.getElementById("profile-country").textContent=data.country||"Not specified";const website=document.getElementById("profile-website");website.href=data.website;if(data.logo_url){const logo=document.getElementById("profile-logo");logo.src=data.logo_url;logo.alt=`${data.name} logo`;logo.hidden=false;}loading.hidden=true;profile.hidden=false;}).catch(error=>{loading.className="form-status error";loading.textContent=error.message;});
</script>
