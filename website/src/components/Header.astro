---
const { current = "" } = Astro.props;
const links = [
  ["Features", "/#features", "features"],
  ["Pricing", "/pricing/", "pricing"],
  ["Documentation", "/docs/", "docs"],
];
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="BarcodeNest home"><img src="/logo-mark.svg" width="32" height="32" alt="" /><span>BarcodeNest</span></a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-nav"><span class="sr-only">Open navigation</span><span></span><span></span></button>
    <nav id="primary-nav" aria-label="Primary navigation">
      <div class="nav-links">{links.map(([label, href, key]) => <a href={href} aria-current={current === key ? "page" : undefined}>{label}</a>)}</div>
      <div class="nav-auth-check" id="auth-navigation-loading" aria-hidden="true"></div>
      <div class="nav-account" id="guest-navigation" hidden><a class="login-link" href="/login/">Login</a><a class="button button-small button-signal" href="/register/">Register</a></div>
      <div class="authenticated-navigation" id="authenticated-navigation" hidden><button class="button button-small button-secondary" id="header-signout" type="button">Sign out</button></div>
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-button"); const nav = document.querySelector<HTMLElement>("#primary-nav");
  button?.addEventListener("click", () => { const open = button.getAttribute("aria-expanded") === "true"; button.setAttribute("aria-expanded", String(!open)); nav?.classList.toggle("is-open", !open); });
  import { getAuthState, signOut } from "../scripts/auth-context";
  async function syncNavigation() { const result = await getAuthState(); if (result.status === "authenticated") { document.querySelector<HTMLElement>("#auth-navigation-loading")?.setAttribute("hidden", ""); const authenticated = document.querySelector<HTMLElement>("#authenticated-navigation"); if (authenticated) authenticated.hidden = false; } else if (result.status === "unauthenticated") { document.querySelector<HTMLElement>("#auth-navigation-loading")?.setAttribute("hidden", ""); const guest = document.querySelector<HTMLElement>("#guest-navigation"); if (guest) guest.hidden = false; } }
  document.querySelector<HTMLButtonElement>("#header-signout")?.addEventListener("click", async (event) => { const signout = event.currentTarget as HTMLButtonElement; signout.disabled = true; signout.textContent = "Signing out..."; try { await signOut(); } catch (error) { signout.disabled = false; signout.textContent = error instanceof Error ? error.message : "Try sign out again"; } });
  syncNavigation();
</script>
