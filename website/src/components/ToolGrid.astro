---
import {tools,toolGroups} from "../content/tools.mjs";
import {platformLandings} from "../content/platform-landings.mjs";
const {developer=true,marketing=true}=Astro.props;
const landingHref=(tool:{name:string;href:string})=>{const landing=platformLandings.find(landing=>landing.name===tool.name);return landing?`/tools/${landing.slug}/`:tool.href;};
---
<div class="tools-directory">{toolGroups.filter(group=>developer||group!=="Developer Tools").map(group=><section aria-label={group}><h2>{group}</h2><div class="platform-tool-grid">{tools.filter(tool=>tool.group===group).map(tool=><a class="platform-tool-card" href={marketing?landingHref(tool):tool.href}><span class="platform-tool-tier">{tool.tier}</span><h3>{tool.name} <span aria-hidden="true">↗</span></h3><p>{tool.description}</p></a>)}</div></section>)}</div>
<style>.tools-directory section{margin:36px 0}.tools-directory h2{font-size:28px}.platform-tool-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.platform-tool-card{padding:24px;border:1px solid var(--line);border-radius:var(--radius);background:var(--white);display:block}.platform-tool-card:hover{border-color:var(--ink)}.platform-tool-card:focus-visible{outline:3px solid var(--ink);outline-offset:3px}.platform-tool-card h3{font-size:20px;line-height:1.3;margin:12px 0}.platform-tool-card p{color:var(--muted);font-size:15px;margin:0}.platform-tool-tier{font:11px 'Geist Mono',monospace;text-transform:uppercase;letter-spacing:.03em}.platform-tool-card h3 span{float:right}@media(max-width:900px){.platform-tool-grid{grid-template-columns:1fr 1fr}}@media(max-width:540px){.platform-tool-grid{grid-template-columns:1fr}}</style>
