---
import AccountLayout from "../layouts/AccountLayout.astro";
const {catalogue=false}=Astro.props;
---
<AccountLayout title={catalogue?"Product Catalogue":"My Barcode Vault"} current={catalogue?"catalogue":"vault"}>
  <header class="portal-header"><div><div class="eyebrow">Your private product workspace</div><h1>{catalogue?"Product Catalogue":"My Barcode Vault"}</h1><p>Give every barcode a home. Save products, keep your details together and reuse them.</p></div><button type="button" id="vault-new" class="button button-signal">Add a product</button></header>
  <section class="portal-panel vault-intro"><div><strong id="vault-capacity">Loading your Vault…</strong><p>Saved products stay here. Opening and editing them uses no lookup credits.</p></div><a href="/barcode-scanner/">Scan a barcode →</a></section>
  <p id="vault-status" role="status" aria-live="polite" class="form-status"></p>
  <section id="vault-editor" class="portal-panel" hidden aria-labelledby="editor-heading"><h2 id="editor-heading" tabindex="-1">Add a private product</h2><p>Your records are visible only to your account. They are not published in the BarcodeNest product database.</p>
    <form id="vault-form"><fieldset id="vault-fields"><div class="vault-fields">
      <label>Barcode or internal identifier<input name="barcode" required maxlength="500" autocomplete="off" /></label>
      <label>Barcode format<select name="barcode_type"><option value="auto">Detect from value</option><option value="ean13">EAN-13</option><option value="upca">UPC-A</option><option value="code128">Code 128</option><option value="code39">Code 39</option><option value="qr">QR</option><option value="ean8">EAN-8</option><option value="gtin14">GTIN-14</option><option value="datamatrix">Data Matrix</option></select></label>
      <div class="vault-lookup"><button type="button" id="vault-lookup" class="button button-secondary">Look up product details</button><small>This explicitly uses your product lookup allowance. Review the details before saving.</small></div>
      <label>Product name<input name="name" required maxlength="200" /></label><label>Internal SKU<input name="sku" maxlength="100" /></label>
      <label>Brand<input name="brand" maxlength="200" /></label><label>Category<input name="category" maxlength="100" /></label>
      <label>Supplier<input name="supplier" maxlength="200" /></label><label>Tags <small>(comma separated, up to 20)</small><input name="tags" maxlength="850" /></label><label>Variant of<select name="variant_of"><option value="">No parent product</option></select></label>
      <label>Collection<input name="collection" maxlength="100" list="vault-collections-list" placeholder="e.g. Shop floor or Autumn range" /></label>
      <label>Price <small>(optional)</small><input name="price" inputmode="decimal" pattern="[0-9]+([.][0-9]{1,2})?" placeholder="12.99" /></label><label>Currency<select name="currency"><option>USD</option><option>EUR</option><option>GBP</option></select></label>
      <label class="vault-wide">Product image link <small>(optional HTTPS URL)</small><input name="image_url" type="url" maxlength="2048" placeholder="https://…" /></label>
      <label class="vault-wide">Notes<textarea name="notes" rows="3" maxlength="4000"></textarea></label>
      <label class="vault-wide">Custom fields <small>(one Name=Value per line, up to 20)</small><textarea name="custom_fields" rows="3" placeholder="Colour=Blue&#10;Supplier=Local supplier"></textarea></label>
    </div><div class="vault-actions"><button type="submit" class="button button-signal">Save product</button><button type="button" id="vault-cancel" class="button button-secondary">Cancel</button></div></fieldset></form><section id="product-identifiers" hidden><h3>Additional identifiers</h3><ul id="identifier-list"></ul><div class="vault-fields"><label>Identifier value<input id="identifier-value" maxlength="500" /></label><label>Format<select id="identifier-kind"><option value="auto">Detect from value</option><option value="code128">Code 128</option><option value="code39">Code 39</option><option value="qr">QR</option><option value="ean13">EAN-13</option><option value="upca">UPC-A</option><option value="ean8">EAN-8</option></select></label></div><button type="button" id="identifier-add" class="button button-secondary">Add identifier</button><p class="portal-note">Adding identifiers is separate from saving other product edits. Up to 20 additional identifiers per record.</p></section><datalist id="vault-collections-list"></datalist>
  </section>
  {catalogue&&<section class="portal-panel"><h2>Import and bulk edit</h2><p><a href="/pricing/">Creator, Starter and Growth</a> include CSV/XLSX imports and bulk changes. Existing records are skipped during import; nothing is overwritten automatically.</p><form id="catalogue-import"><label for="catalogue-file">CSV or XLSX with barcode and name columns</label><input id="catalogue-file" type="file" accept=".csv,.xlsx" required /><button type="submit" class="button button-secondary">Import file</button></form><button type="button" id="catalogue-report" class="button button-secondary" hidden>Download import report</button><form id="catalogue-bulk-edit"><label>Field<select id="bulk-field"><option value="category">Category</option><option value="collection">Collection</option><option value="supplier">Supplier</option><option value="tags">Tags</option><option value="notes">Notes</option><option value="price_minor">Price</option></select></label><label>New value<input id="bulk-value" maxlength="4000" /></label><label>Price currency<select id="bulk-currency"><option>USD</option><option>EUR</option><option>GBP</option></select></label><button type="submit" class="button button-secondary">Apply to selected products</button></form><p class="portal-note">Imports and bulk edits consume processing rows. Files are bounded per request; formulas and external workbook links are rejected. Use tags as JSON arrays and custom_fields as a JSON object in imports.</p></section>}
  <section class="portal-section" aria-labelledby="vault-products-heading"><div class="portal-section-head"><h2 id="vault-products-heading">Your products</h2><div class="vault-actions"><button type="button" id="vault-export-csv" class="button button-secondary button-small">Export CSV</button>{catalogue&&<button type="button" id="vault-export-xlsx" class="button button-secondary button-small">Export XLSX</button>}<button type="button" id="vault-export-json" class="button button-secondary button-small">Export JSON</button></div></div>
    <p id="vault-export-note" class="portal-note">Exports are included in Creator, Starter and Growth. CSV exports can be imported into Excel with barcode columns set to Text.</p>
    <form id="vault-search" class="vault-toolbar"><label>Search products<input id="vault-query" maxlength="200" type="search" placeholder="Name, barcode, SKU or brand" /></label><label>Collection<select id="vault-collection"><option value="">All collections</option></select></label>{catalogue&&<><label>Category<input id="filter-category" maxlength="100" /></label><label>Supplier<input id="filter-supplier" maxlength="200" /></label><label>Price status<select id="filter-price"><option value="">Any price status</option><option value="true">Has price</option><option value="false">Missing price</option></select></label><label>Sort<select id="filter-sort"><option value="updated">Latest update</option><option value="name">Name</option><option value="sku">SKU</option></select></label></>}<button class="button button-secondary" type="submit">Search</button></form>
    <div class="vault-actions"><button type="button" id="vault-labels" class="button button-secondary">Print selected labels</button><button type="button" id="vault-assign-skus" class="button button-secondary">Assign SKUs</button><button type="button" id="vault-label-studio" class="button button-secondary">Design selected labels</button><span id="vault-selected" class="portal-note">Select products to create a PDF.</span></div>
    <div id="vault-products" class="vault-products" aria-live="polite"></div>
    <div class="vault-actions vault-pagination"><button type="button" id="vault-prev" class="button button-secondary">Previous</button><span id="vault-page"></span><button type="button" id="vault-next" class="button button-secondary">Next</button></div>
    <p class="portal-note">A saved record stores the identifier and your product details. Barcode images and PDFs are generated when requested and use their separate allowances. Label text supports printable Latin characters and long names are shortened. Collection exports include the selected collection; search text only filters the on-screen list.</p>
  </section>
</AccountLayout>
<script src="../scripts/vault.ts"></script>
<style>
  #catalogue-import,#catalogue-bulk-edit{display:flex;align-items:end;gap:12px;flex-wrap:wrap;margin:20px 0}#catalogue-bulk-edit label{display:flex;flex-direction:column;gap:6px}#catalogue-import input,#catalogue-bulk-edit input,#catalogue-bulk-edit select{min-height:44px;max-width:100%;padding:8px;border:1px solid var(--line);background:var(--paper);font:inherit}#product-identifiers{margin-top:24px}#product-identifiers li{overflow-wrap:anywhere}
  .vault-intro{display:flex;justify-content:space-between;align-items:center;gap:24px}.vault-intro p{margin-bottom:0}.vault-actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin:16px 0}.vault-fields{display:grid;grid-template-columns:1fr 1fr;gap:20px}.vault-fields label,.vault-toolbar label{display:flex;flex-direction:column;gap:8px;min-width:0;font-weight:600}.vault-fields small{font-weight:400;color:var(--muted)}.vault-fields input,.vault-fields textarea,.vault-fields select,.vault-toolbar input,.vault-toolbar select{width:100%;min-width:0;box-sizing:border-box;padding:12px;border:1px solid var(--line);border-radius:5px;background:var(--paper);color:var(--ink);font:inherit;min-height:44px}.vault-wide,.vault-lookup{grid-column:1/-1}.vault-lookup{display:flex;align-items:center;gap:16px}.vault-toolbar{display:grid;grid-template-columns:1fr minmax(150px,220px) auto;gap:16px;align-items:end;margin:24px 0}.vault-products :global(article){display:grid;grid-template-columns:auto 1fr auto;align-items:start;gap:16px;padding:24px 0;border-bottom:1px solid var(--line)}.vault-products :global(h3){margin:0 0 8px;font-size:20px}.vault-products :global(p){margin:4px 0;overflow-wrap:anywhere}.vault-products :global(.vault-code){font-family:'Geist Mono',monospace;font-size:14px;overflow-wrap:anywhere}.vault-products :global(.vault-row-actions){display:flex;flex-wrap:wrap;gap:8px;max-width:220px}.vault-products :global(input[type=checkbox]){width:22px;height:22px;margin-top:4px;accent-color:var(--ink)}#vault-fields{border:0;padding:0;margin:0;min-width:0}#vault-status{overflow-wrap:anywhere}.vault-pagination{justify-content:space-between}#vault-editor{margin:24px 0}#vault-editor:focus-within{scroll-margin-top:24px}
  @media(max-width:800px){.vault-toolbar{grid-template-columns:1fr 1fr}.vault-toolbar button{grid-column:1/-1}.vault-intro{align-items:start;flex-direction:column}.vault-products :global(article){grid-template-columns:auto 1fr}.vault-products :global(.vault-row-actions){grid-column:2;max-width:none}}@media(max-width:520px){.vault-fields,.vault-toolbar{grid-template-columns:1fr}.vault-lookup{align-items:start;flex-direction:column}.vault-pagination{gap:8px}.vault-pagination .button{padding:10px}}
</style>
