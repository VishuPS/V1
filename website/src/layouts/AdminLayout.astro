---
import BaseLayout from "./BaseLayout.astro";
const { title, current = "dashboard" } = Astro.props;
const links = [
  ["Overview", "/admin/", "dashboard"],
  ["Users", "/admin/users/", "users"],
  ["Contributions", "/admin/contributions/", "contributions"],
];
---
<BaseLayout title={`${title} - BarcodeNest Admin`} description="BarcodeNest administration." noindex={true}>
  <section class="admin-page">
    <div class="admin-shell container">
      <aside class="admin-sidebar" aria-label="Admin navigation">
        <div><span class="admin-kicker">BarcodeNest</span><strong>Admin</strong></div>
        <nav>{links.map(([label, href, key]) => <a href={href} aria-current={current === key ? "page" : undefined}>{label}</a>)}</nav>
        <a class="admin-back" href="/dashboard/">Back to dashboard</a>
      </aside>
      <div class="admin-main">
        <div id="admin-loading" class="admin-loading" role="status">Checking administrator access…</div>
        <div id="admin-denied" class="admin-denied" hidden>
          <div class="eyebrow">Restricted</div><h1>Administrator access required.</h1>
          <p>Your account is authenticated but does not have permission to open this area.</p>
          <a class="button button-secondary" href="/dashboard/">Return to dashboard</a>
        </div>
        <div id="admin-app" hidden><slot /></div>
      </div>
    </div>
  </section>
</BaseLayout>
