---
import BaseLayout from "./BaseLayout.astro";
const { title, current = "dashboard" } = Astro.props;
const links = [
  ["Overview", "/workspace/", "workspace"],
  ["My Barcode Vault", "/vault/", "vault"],
  ["Barcode Lookup", "/barcode-lookup/", "lookup"],
  ["Generator", "/barcode-generator/", "generator"],
  ["Scanner", "/barcode-scanner/", "scanner"],
  ["Barcode Labels", "/barcode-labels/", "labels"],
  ["CSV Enrichment", "/csv-product-enrichment/", "enrichment"],
  ["Profile", "/profile/", "profile"],
  ["Account", "/account/", "account"],
  ["API Management", "/api-keys/", "api-keys"],
  ["Subscription", "/billing/", "billing"],
  ["Contributions", "/contributions/", "contributions"],
  ["Settings", "/settings/", "settings"],
];
---
<BaseLayout title={`${title} - BarcodeNest`} description="Manage your BarcodeNest workspace, saved products and tools." noindex={true}>
  <section class="portal-page"><div class="portal-shell container">
    <aside class="portal-sidebar" aria-label="Account navigation"><div class="portal-identity"><span>BarcodeNest</span><strong>Your workspace</strong></div><nav>{links.map(([label, href, key]) => <a href={href} aria-current={current === key ? "page" : undefined}>{label}</a>)}</nav></aside>
    <div class="portal-main"><div id="protected-loading" class="protected-state" role="status">Verifying your session&hellip;</div><div id="protected-app" hidden><slot /></div></div>
  </div></section>
</BaseLayout>
