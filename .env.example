APP_NAME=Grocery & Retail Product Barcode API
APP_ENV=development
DATABASE_URL=sqlite:///./products.db
AUTO_CREATE_TABLES=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
BATCH_LIMIT=100
OPEN_FOOD_FACTS_DATASET_URL=https://static.openfoodfacts.org/data/openfoodfacts-products.jsonl.gz
INGESTION_BATCH_SIZE=1000
API_KEY_HASH_SECRET=replace-with-a-long-random-production-secret
JWT_SECRET=replace-with-a-separate-long-random-production-secret
JWT_ISSUER=https://api.barcodenest.com
JWT_AUDIENCE=barcodenest-account
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_SECURE=false
REGISTRATION_ENABLED=true
WEBSITE_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=BarcodeNest <notifications@barcodenest.com>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_STATE_MINUTES=10
# Production:
# APP_ENV=production
# AUTH_COOKIE_SECURE=true
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# AUTO_CREATE_TABLES=false
# CORS_ALLOWED_ORIGINS=https://barcodenest.com,https://www.barcodenest.com
# TRUSTED_HOSTS=api.barcodenest.com,YOUR_PROVIDER_HOSTNAME
# WEBSITE_URL=https://barcodenest.com
# OAuth callback URLs:
# https://api.barcodenest.com/v1/auth/oauth/google/callback
# https://api.barcodenest.com/v1/auth/oauth/github/callback
# PORT=8000
# FORWARDED_ALLOW_IPS=127.0.0.1
# JSON override example:
# PLAN_LIMITS={"FREE":{"monthly_lookups":250,"requests_per_minute":30},"STARTER":{"monthly_lookups":2000,"requests_per_minute":300},"GROWTH":{"monthly_lookups":5000,"requests_per_minute":1200}}
POSTGRES_DB=grocery_api
POSTGRES_USER=grocery
POSTGRES_PASSWORD=grocery-local
POSTGRES_PORT=5432
